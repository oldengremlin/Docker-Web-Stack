#!/bin/sh
#
# mkpass <рядок> — детермінований пароль: HMAC-SHA512(майстер-ключ, рядок),
# base64 без '+', '/' і '=', перші 48 символів.
#
# Той самий алгоритм і той самий ключ, що й у `dcpmgmt secrets`: для домену
# зі стека `mkpass example.com` і `dcpmgmt secrets show example.com` дають
# один і той самий рядок. Тому утиліта годиться і поза проєктом — для
# будь-чого, що треба мати відтворюваним, не зберігаючи.
#
# Ключ створюється при першому запуску (48 випадкових байтів, права 0400)
# і більше не змінюється: зміна зробить усі видані паролі невідтворюваними.
# Копію ключа — в менеджер паролів. Це і є бекап усіх паролів одразу.
#
# Шлях до ключа: $MKPASS_KEY, інакше ~/.dcp-master-key
#
set -eu

KEY="${MKPASS_KEY:-$HOME/.dcp-master-key}"
LENGTH=48

if [ $# -ne 1 ]; then
    echo "використання: $(basename "$0") <рядок>" >&2
    echo "ключ: $KEY" >&2
    exit 1
fi

if [ ! -f "$KEY" ]; then
    # umask, а не chmod після створення: інакше ключ устигає полежати
    # з дефолтними правами рівно стільки, скільки триває запис.
    ( umask 377; head -c 48 /dev/urandom | base64 -w0 > "$KEY"; echo >> "$KEY" )
    echo "створено майстер-ключ $KEY (0400) — покладіть копію в менеджер паролів" >&2
fi

printf '%s' "$1" \
    | openssl dgst -sha512 -hmac "$(cat "$KEY")" -binary \
    | base64 -w0 | tr -d '+/=' | head -c "$LENGTH"
echo
