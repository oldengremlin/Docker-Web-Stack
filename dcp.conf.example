# dcp.conf — налаштування інсталяції. Скопіювати в dcp.conf і виправити.
# Формат: key = value, '#' — коментар. Читається dcpmgmt і нічим більше.
# У git НЕ потрапляє (див. .gitignore): тут е-mail і назва проєкту docker.

# Назва docker compose проєкту. КРИТИЧНО: визначає префікс імен volume'ів
# (<project>_db-foocom). Якщо змінити на працюючому сервері — compose
# створить НОВІ порожні volume'и замість наявних. На успадкованій
# інсталяції значення має збігатися з іменем каталогу, з якого стек
# запускався досі (історично — docker-compose-project).
project = docker-compose-project

# Корінь даних сайтів на хості: <sites_root>/<domain>/{web,db}
sites_root = /var/sites

# Каталог із глобальними додатками до конфігурації nginx (монтується
# в /etc/nginx/conf.d). Створюється командою `dcpmgmt init`.
nginx_conf_dir = /var/sites/nginx-conf

# Каталог, у якому certbot тримає стан (bind для volume'ів certbot-etc/var)
letsencrypt_dir = /var/sites/letsencrypt

# E-mail для реєстрації в Let's Encrypt
certbot_email = you@example.com

# Образи за замовчуванням для нових сайтів
wordpress_image = wordpress:6.8.3-php8.4-fpm
db_image        = mariadb:latest
nginx_image     = nginx:latest
certbot_image   = certbot/certbot

# Часовий пояс контейнера nginx
tz = Europe/Kiev

# Домен, чий vhost несе `reuseport` на порті 443 (QUIC). Має бути рівно
# один на весь стек, інакше nginx падає з "duplicate listen options".
# Порожньо — reuseport не виставляється взагалі.
quic_reuseport_domain =

# Кількість воркерів nginx. auto = за кількістю ядер.
#
# Пов'язано з quic_bpf нижче: з кількома воркерами і reuseport пакети
# QUIC-з'єднання після зміни IP клієнта (міграція з'єднання) можуть
# прилетіти не тому воркеру, що тримає з'єднання. Варіантів два —
# або quic_bpf, або worker_processes = 1, і тоді питання не виникає.
worker_processes = auto

# eBPF-маршрутизація QUIC-пакетів між воркерами (директива головного
# контексту, у conf.d не працює). Вмикає коректну міграцію QUIC-з'єднань.
#
# ЦІНА: контейнеру webserver доведеться видати CAP_BPF і CAP_NET_ADMIN та
# послабити seccomp — типовий профіль docker блокує виклик bpf() усім, крім
# CAP_SYS_ADMIN. Це той самий контейнер, що дивиться в інтернет.
#
# Якщо привілеїв забракне, nginx може не стартувати — а він один на всі
# домени. Вмикайте свідомо і одразу після `dcpmgmt apply` дивіться
# `docker logs webserver`. Відкат: повернути off і повторити apply.
#
# Для звичайного сайту лишайте off: без quic_bpf ламається лише міграція
# QUIC-з'єднання при зміні IP клієнта, і клієнт просто переустановлює
# з'єднання — на сайті це непомітно.
#
# on — dcpmgmt згенерує nginx/nginx.conf і додасть привілеї в compose.
# off — nginx/nginx.conf не генерується (якщо ви написали свій — він усе
#       одно монтується).
quic_bpf = off

# Як часто webserver робить `nginx -s reload`, щоб підхопити подовжені
# сертифікати (сертифікат оновлюється на диску, але nginx тримає старий
# у пам'яті до перезавантаження конфігурації).
reload_interval = 6h

# Інтервал циклу `certbot renew` у спільному контейнері certbot
renew_interval = 12h
