# Головний конфіг nginx. Згенеровано dcpmgmt — не редагувати вручну.
# Джерело істини: dcp.conf. Перегенерувати: dcpmgmt render
#
# Цей файл існує тільки заради директив ГОЛОВНОГО контексту, яких не можна
# поставити у conf.d: той інклюдиться всередині http{}. Передусім quic_bpf.
# Решта — відтворення типового конфіга образу nginx, щоб нічого не загубити.

user  nginx;
worker_processes  {{worker_processes}};

error_log  /var/log/nginx/error.log notice;
pid        /var/run/nginx.pid;

{{quic_bpf}}
events {
    worker_connections  1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    access_log  /var/log/nginx/access.log  main;

    sendfile        on;
    keepalive_timeout  65;

    include /etc/nginx/conf.d/*.conf;
}
