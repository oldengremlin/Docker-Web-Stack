# ── Секрети: ніколи не в git ────────────────────────────────────────────
secrets/
*.env
!*.env.example
dcp.conf
# Майстер-ключ за замовчуванням живе поза проєктом, але якщо хтось
# переналаштує master_key_file всередину — хай не поїде в git.
*.master-key
.dcp-master-key

# ── Стан конкретної інсталяції ──────────────────────────────────────────
# Генерується з реєстру (domains/*.conf) командою `dcpmgmt render`.
# Тримати в git чи ні — рішення власника інсталяції; для публічного
# репозиторію ці каталоги мають бути порожні (див. README, розділ
# "Публікація репозиторію").
/docker-compose.yml
/docker-compose.main.yml
/docker-compose.domains/
/nginx/
/domains/

# ── Сміття ──────────────────────────────────────────────────────────────
BAK/
config.yaml
*.bak
*.orig
*.rej
*~
