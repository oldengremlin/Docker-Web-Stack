#!/usr/bin/perl
#
# dcpmgmt — керування доменами мультидоменного docker-стека
#           (один nginx-фронтенд + per-домен WordPress / redirect / proxy).
#
# Джерело істини — реєстр domains/*.conf і dcp.conf. Усе інше
# (docker-compose.yml, docker-compose.main.yml, nginx/*.conf,
# docker-compose.domains/*.yml) генерується з нього за шаблонами
# з templates/. Ручні правки в згенерованому не зникають мовчки:
# `render` без --force не перезаписує наявні файли, а `render --diff`
# показує розбіжність.
#
# Документація: README.md
#
# SPDX-License-Identifier: GPL-2.0-only

use strict;
use warnings;
use utf8;                       # у вихідному коді є кирилиця
use File::Basename qw(basename dirname);
use File::Path qw(make_path remove_tree);
use File::Temp qw(tempdir);
use Cwd qw(abs_path);
use Getopt::Long qw(GetOptionsFromArray);
use Digest::SHA qw(hmac_sha512);
use MIME::Base64 qw(encode_base64);

our $VERSION = '1.14.0';

my $ROOT = dirname(abs_path($0));

binmode STDIN,  ':encoding(UTF-8)';
binmode STDOUT, ':encoding(UTF-8)';
binmode STDERR, ':encoding(UTF-8)';

$| = 1;   # без буферизації: інакше stdout і stderr плутаються місцями

# ─────────────────────────── вивід ───────────────────────────

my $NOCOLOR = (!-t STDOUT) || $ENV{NO_COLOR};
sub c { my ($code, $s) = @_; return $NOCOLOR ? $s : "\e[${code}m${s}\e[0m"; }
sub say_ok   { print c('1;32', '  ok  '), " @_\n"; }
sub say_info { print c('1;34', ' info '), " @_\n"; }
sub say_warn { print c('1;33', ' увага'), " @_\n"; }
sub say_step { print "\n", c('1;37', "== @_"), "\n"; }
sub die_err  { print STDERR c('1;31', ' збій '), " @_\n"; exit 1; }
sub say_err  { print c('1;31', 'помилка'), " @_\n"; }

my $YES = 0;
sub confirm {
    my ($question) = @_;
    return 1 if $YES;
    print c('1;33', ' ? '), " $question [так/ні]: ";
    my $answer = <STDIN>;
    return 0 unless defined $answer;
    $answer =~ s/^\s+|\s+$//g;
    return 1 if $answer =~ /^(так|т|yes|y)$/i;
    return 0 if $answer =~ /^(ні|н|no|n|)$/i;
    say_warn "не зрозумів відповідь '$answer' — вважаю за відмову";
    return 0;
}

# ─────────────────────────── конфіг ───────────────────────────

my %CFG = (
    project         => 'docker-compose-project',
    sites_root      => '/var/sites',
    nginx_conf_dir  => '/var/sites/nginx-conf',
    letsencrypt_dir => '/var/sites/letsencrypt',
    certbot_email   => '',
    wordpress_image => 'wordpress:php8.4-fpm',
    db_image        => 'mariadb:latest',
    nginx_image     => 'nginx:latest',
    certbot_image   => 'certbot/certbot',
    tz              => 'Europe/Kiev',
    quic_reuseport_domain => '',
    worker_processes => 'auto',
    password_mode   => 'derived',
    master_key_file => '~/.dcp-master-key',
    quic_bpf        => 'off',
    reload_interval => '6h',
    renew_interval  => '12h',
    renew_retry_interval => '1h',
);

sub read_kv {
    my ($path) = @_;
    my %h;
    open my $fh, '<:encoding(UTF-8)', $path or return;
    while (my $l = <$fh>) {
        chomp $l;
        $l =~ s/^\s+|\s+$//g;
        next if $l eq '' || $l =~ /^#/;
        my ($k, $v) = $l =~ /^([A-Za-z0-9_]+)\s*=\s*(.*)$/ or next;
        $v =~ s/\s+$//;
        $h{lc $k} = $v;
    }
    close $fh;
    return %h;
}

sub load_config {
    my $path = "$ROOT/dcp.conf";
    unless (-f $path) {
        die_err "немає $path. Скопіюйте dcp.conf.example -> dcp.conf і виправте,\n"
              . "       або запустіть: dcpmgmt init";
    }
    my %h = read_kv($path);
    $CFG{$_} = $h{$_} for grep { exists $CFG{$_} } keys %h;
    for my $unknown (grep { !exists $CFG{$_} } keys %h) {
        say_warn "dcp.conf: невідомий ключ '$unknown' — проігноровано";
    }
    die_err "dcp.conf: не заповнено certbot_email" unless $CFG{certbot_email};
}

# ─────────────────────── імена, похідні від домену ───────────────────────
#
# Усі ідентифікатори БД виводяться з імені домену детерміновано —
# нічого не питаємо в користувача і нічого не вигадуємо двічі.
#   www.ukr-com.net -> sid  wwwukr-comnet   (крапки геть, дефіси лишаються)
#                      db   wwwukr-comnet
#                      user uwwwukr-comnet
#                      host db-wwwukr-comnet
# Саме так названі наявні продакшн-контейнери — сумісність навмисна.

sub sid_of {
    my ($domain) = @_;
    my $s = lc $domain;
    $s =~ s/\.//g;
    return $s;
}

# Суфікс для обрізаних імен: потрібен лише для унікальності, не для
# криптографії. Digest::MD5 є в core perl, але якщо збірка без нього —
# контрольної суми рядка вистачить для тієї ж мети.
sub md5_hex_of {
    my ($value) = @_;
    eval { require Digest::MD5; 1 }
        or return substr(sprintf('%08x', unpack('%32C*', $value)), 0, 8);
    return substr(Digest::MD5::md5_hex($value), 0, 8);
}

# Ліміт імені бази — 64 символи, імені користувача — 32 (MySQL; MariaDB
# щедріша, але тримаємось меншого). Довші домени обрізаємо й доліплюємо
# суфікс, щоб два схожі домени не отримали однакове ім'я.
sub db_name_of {
    my ($domain) = @_;
    my $name = sid_of($domain);
    return length($name) <= 64 ? $name : substr($name, 0, 55) . '_' . md5_hex_of($domain);
}

sub db_user_of {
    my ($domain) = @_;
    my $user = 'u' . sid_of($domain);
    return length($user) <= 32 ? $user : substr($user, 0, 23) . '_' . md5_hex_of($domain);
}

sub random_password {
    my $length   = 48;
    my @alphabet = ('A'..'Z', 'a'..'z', 0..9);   # 62 символи

    # Байти, що не діляться націло на розмір алфавіту, відкидаємо, а не
    # беремо за модулем: 256 % 62 = 8, тож перші вісім символів алфавіту
    # інакше випадали б частіше за решту.
    my $limit = int(256 / @alphabet) * @alphabet;

    open my $fh, '<:raw', '/dev/urandom' or die_err 'немає /dev/urandom';
    my $password = '';
    while (length($password) < $length) {
        read $fh, my $buf, $length or die_err 'не читається /dev/urandom';
        $password .= $alphabet[$_ % @alphabet] for grep { $_ < $limit } unpack 'C*', $buf;
    }
    close $fh;
    return substr($password, 0, $length);
}

# Тільки нижній регістр і мінімум одна крапка. Кирилиця не приймається
# свідомо: ім'я домену стає іменем каталогу, контейнера й бази, тож
# інтернаціоналізовані домени подаються в punycode (xn--...), як вони й
# записані в наявному стеку.
sub valid_domain {
    my ($domain) = @_;
    return 0 if length($domain) > 253;
    return $domain =~ /^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$/;
}

# ─────────────────────────── реєстр ───────────────────────────

sub reg_dir  { "$ROOT/domains" }
sub reg_path { my ($d) = @_; reg_dir() . "/$d.conf" }

sub reg_load_one {
    my ($d) = @_;
    my %h = read_kv(reg_path($d));
    return undef unless %h;
    $h{domain} = $d;
    $h{type}     //= 'redirect';
    $h{http3}    //= 'on';
    $h{enabled}  //= 'yes';
    return \%h;
}

sub reg_all {
    my @out;
    for my $f (sort glob(reg_dir() . '/*.conf')) {
        my $d = basename($f, '.conf');
        my $e = reg_load_one($d) or next;
        push @out, $e;
    }
    return @out;
}

sub reg_enabled { grep { $_->{enabled} eq 'yes' } reg_all() }

sub reg_save {
    my ($e) = @_;
    my $d = $e->{domain};
    make_path(reg_dir()) unless -d reg_dir();
    my @order = qw(type domain target upstream app_service image db_image
                   db_name db_user php_service password_mode extra_env http3
                   enabled note);
    my $out = "# Реєстр домену $d. Джерело істини для dcpmgmt render.\n"
            . "# Змінили щось руками — виконайте: dcpmgmt render --diff\n";
    for my $k (@order) {
        next unless defined $e->{$k} && $e->{$k} ne '';
        $out .= sprintf("%-11s = %s\n", $k, $e->{$k});
    }
    write_file(reg_path($d), $out, force => 1, quiet => 1);
    return 1;
}

# ─────────────────────────── файли ───────────────────────────

# Вміст nginx-конфіга без коментарів. Закоментований `# listen 443 quic
# reuseport;` — це не конфігурація, і шукати в ньому directives не можна.
sub nginx_uncommented {
    my ($path) = @_;
    my $c = slurp($path) // return undef;
    $c =~ s/(^|\s)#[^\n]*//g;
    return $c;
}

# Усі імена з директив server_name у конфізі домену.
sub nginx_server_names {
    my ($path) = @_;
    my $conf = nginx_uncommented($path) // return ();
    my %names;
    while ($conf =~ /^\s*server_name\s+([^;]+);/mg) {
        $names{$_} = 1 for grep { length } split /\s+/, $1;
    }
    return sort keys %names;
}

# Набір директив конфіга, без огляду на порядок і форматування. Потрібен,
# щоб відповісти на єдине питання, яке справді хвилює при регенерації:
# чи не зникає щось назовсім. Текстовий diff на це не відповідає —
# директива, що переїхала на двадцять рядків нижче, виглядає в ньому як
# видалена, і в тисячі рядків різниці це не перевіриш оком.
#
# Евристика: назва + аргументи до ';' або '{'. Для звірки двох версій
# одного конфіга цього досить.
sub nginx_directives {
    my ($text) = @_;
    return {} unless defined $text;
    $text =~ s/(^|\s)#[^\n]*//g;
    my %found;
    while ($text =~ /([a-z_][a-z_0-9]*)([^;{}]*)([;{])/g) {
        my ($name, $args) = ($1, $2);
        next if $name =~ /^(server|http|events)$/;
        $args =~ s/\s+/ /g;
        $args =~ s/^ | $//g;
        $found{ length $args ? "$name $args" : $name } = 1;
    }
    return \%found;
}

# Директиви, які є в наявному конфізі й зникають у згенерованому.
sub report_lost_directives {
    my ($path, $generated) = @_;
    my $current = slurp($path) // return;
    my $have = nginx_directives($generated);
    my @lost = sort grep { !$have->{$_} } keys %{ nginx_directives($current) };
    unless (@lost) {
        say_ok basename($path) . ' — жодної директиви не втрачено (решта різниці — порядок і форматування)';
        return;
    }
    say_warn basename($path) . ' — зникають директиви:';
    say_warn "    $_" for @lost;
}

sub slurp {
    my ($p) = @_;
    open my $fh, '<:encoding(UTF-8)', $p or return undef;
    local $/;
    my $c = <$fh>;
    close $fh;
    return $c;
}

# write_file($path, $content, force => 0|1, diff => 0|1, mode => 0644, quiet => 0|1)
#   Наявний файл із іншим вмістом без force НЕ перезаписується — це головна
#   гарантія проти «скрипт затер мої ручні правки на проді».
sub write_file {
    my ($path, $content, %o) = @_;
    my $rel = $path;
    $rel =~ s/^\Q$ROOT\E\///;
    my $old = slurp($path);

    if (defined $old && $old eq $content) {
        say_ok "$rel — без змін" unless $o{quiet};
        return 'unchanged';
    }
    if (defined $old && !$o{force}) {
        # Для файла, що належить адміну, «згенероване» — це порожній каркас
        # із CHANGE-ME, а не пропозиція змін. Показувати таку різницю —
        # лякати користувача тим, чого ніколи не станеться.
        if ($o{owned_by_admin}) {
            say_info "$rel — ваш файл, dcpmgmt його не чіпає (ні render, ні --force). "
                   . 'Для цього домену інструмент відповідає лише за nginx-конфіг '
                   . 'і за сертифікат (спільний сервіс certbot).';
            return 'skipped';
        }
        if ($o{diff}) {
            say_info "$rel — відрізняється від згенерованого:";
            show_diff($path, $content);
        } else {
            say_warn "$rel — існує і відрізняється, залишено як є (--force перезапише, --diff покаже різницю)";
        }
        return 'skipped';
    }

    make_path(dirname($path)) unless -d dirname($path);
    if (defined $old) {
        my $bak = "$path.bak";
        if (open my $bh, '>:encoding(UTF-8)', $bak) { print $bh $old; close $bh; chmod 0600, $bak; }
    }
    open my $fh, '>:encoding(UTF-8)', $path or die_err "не можу писати $path: $!";
    # Права виставляються до запису вмісту: інакше файл із паролем устигає
    # полежати з дефолтними 0644 рівно стільки, скільки триває print.
    chmod($o{mode}, $path) if $o{mode};
    print $fh $content;
    close $fh;
    say_ok(defined $old ? "$rel — оновлено" : "$rel — створено") unless $o{quiet};
    return defined $old ? 'updated' : 'created';
}

sub show_diff {
    my ($path, $new) = @_;
    my $dir = tempdir(CLEANUP => 1);
    open my $fh, '>:encoding(UTF-8)', "$dir/new" or return;
    print $fh $new;
    close $fh;
    system('diff', '-u', '--label', $path, '--label', "$path (згенероване)", $path, "$dir/new");
}

# ─────────────────────────── шаблони ───────────────────────────

sub render_template {
    my ($name, %vars) = @_;
    my $path = "$ROOT/templates/$name";
    my $template = slurp($path) or die_err "немає шаблону $path";
    my %missing;
    $template =~ s/\{\{(\w+)\}\}/
        defined $vars{$1} ? $vars{$1} : do { $missing{$1} = 1; "{{$1}}" }
    /ge;
    # Незаповнений плейсхолдер лишається в тексті й дійде до nginx або
    # compose як сміття. Не вбиваємо генерацію, але кажемо вголос, бо
    # інакше причину шукатимуть у повідомленні nginx, а не в шаблоні.
    say_warn "шаблон $name: не заповнено " . join(', ', map { "{{$_}}" } sort keys %missing)
        if %missing;
    return $template;
}

# ─────────────────────────── docker ───────────────────────────

sub run {
    my (@cmd) = @_;
    say_info c('0;36', join ' ', @cmd);
    my $rc = system(@cmd);
    return $rc == 0;
}

# Як run(), але без жодного виводу: потрібен тільки код повернення.
# Без shell, щоб аргументи не інтерпретувалися.
sub run_quiet {
    my (@cmd) = @_;
    my $pid = fork();
    die_err "fork: $!" unless defined $pid;
    unless ($pid) {
        open STDOUT, '>', '/dev/null';
        open STDERR, '>', '/dev/null';
        exec @cmd;
        exit 127;
    }
    waitpid $pid, 0;
    return $? == 0;
}

sub run_or_die {
    my (@cmd) = @_;
    run(@cmd) or die_err "команда завершилась помилкою: @cmd";
}

# Вивід команди без запуску шелла (аргументи можуть містити що завгодно).
# stderr глушиться навмисно: docker пише туди попередження, які інакше
# потраплять у розбір як дані.
sub capture {
    my (@cmd) = @_;
    my $pid = open(my $fh, '-|');
    die_err "fork: $!" unless defined $pid;
    if (!$pid) { open STDERR, '>', '/dev/null'; exec @cmd; exit 127; }
    local $/;
    my $out = <$fh>;
    close $fh;
    return defined $out ? $out : '';
}

sub have_docker { return system('docker version >/dev/null 2>&1') == 0 }

sub compose { my (@a) = @_; chdir $ROOT; return run('docker', 'compose', @a) }

sub container_running {
    my ($name) = @_;
    my $out = capture('docker', 'ps', '--format', '{{.Names}}');
    return grep { $_ eq $name } split /\n/, $out;
}

# `docker ps` показує і контейнер у стані restarting, тож самої лише
# присутності в списку мало: exec у контейнер, який щойно вмер, падає
# помилкою runc ("failed to open /proc/.../ns/ipc"), і це легко прийняти
# за провал nginx -t, хоч перевірка навіть не запускалася.
sub container_state {
    my ($name) = @_;
    my $out = capture('docker', 'inspect', '-f', '{{.State.Status}}', $name) // '';
    chomp $out;
    return $out;   # running | restarting | exited | created | '' (немає)
}

sub nginx_test_reload {
    my $state = container_state('webserver');

    if ($state eq '' || $state eq 'created') {
        say_warn 'контейнер webserver не запущено — nginx -t пропущено';
        return 0;
    }
    # Тут немає "старої конфігурації в пам'яті", якою можна втішати: nginx
    # не піднявся взагалі, отже сайти цього стека зараз недоступні.
    if ($state ne 'running') {
        die_err "webserver не працює (стан: $state) — nginx не стартував, і сайти\n"
              . "       цього стека зараз недоступні. nginx -t тут не допоможе:\n"
              . "       причину видно тільки в логах контейнера.\n"
              . "       Дивіться: docker logs webserver --tail 30";
    }

    unless (run('docker', 'exec', 'webserver', 'nginx', '-t')) {
        my $now = container_state('webserver');
        die_err "webserver перестав працювати (стан: $now) — nginx -t не виконався\n"
              . "       взагалі, тож про конфігурацію це нічого не каже.\n"
              . "       Дивіться: docker logs webserver --tail 30"
            if $now ne 'running';
        die_err "nginx -t не пройшов. Конфігурацію НЕ перезавантажено, працюючий nginx\n"
              . "       далі крутиться зі старою конфігурацією в пам'яті — сайти живі.\n"
              . "       Полагодьте конфіг і повторіть: dcpmgmt apply";
    }
    run_or_die('docker', 'exec', 'webserver', 'nginx', '-s', 'reload');
    say_ok 'nginx перезавантажено';
    return 1;
}

# Перевірка згенерованої конфігурації в одноразовому контейнері — ДО того,
# як чіпати робочий webserver. Той самий образ і ті самі монти, але окремий
# контейнер: якщо конфіг зламаний, робочий nginx про це не дізнається і
# далі крутиться зі старим у пам'яті.
#
# Має сенс лише поки стек працює: на зупиненому впаде резолв upstream-імен,
# і це буде хибна тривога. Зупинений стек нічим і не ризикує — зламаний
# конфіг просто не дасть йому піднятись.
sub preflight_nginx {
    my (@doms) = @_;
    return 1 unless have_docker();
    my $state = container_state('webserver');
    return 1 unless $state eq 'running' || $state eq 'restarting';

    my $network = "$CFG{project}_app-network";
    unless (grep { $_ eq $network } split /\n/, capture('docker', 'network', 'ls', '--format', '{{.Name}}')) {
        say_warn "мережі $network немає — перевірку конфігурації пропущено";
        return 1;
    }

    my @mounts = (
        "$CFG{nginx_conf_dir}:/etc/nginx/conf.d",
        "$ROOT/nginx/custom:/etc/nginx/custom:ro",
        "$CFG{letsencrypt_dir}/etc:/etc/letsencrypt:ro",
    );
    push @mounts, main_nginx_conf_path() . ':/etc/nginx/nginx.conf:ro' if -f main_nginx_conf_path();
    for my $e (@doms) {
        my $d = $e->{domain};
        push @mounts, "$ROOT/nginx/nginx-$d.conf:/etc/nginx/conf.d/$d.conf:ro";
        push @mounts, "$CFG{sites_root}/$d/web:/var/www/html/$d:ro";
    }

    say_step 'Перевірка згенерованої конфігурації в одноразовому контейнері';
    # --entrypoint nginx в обхід docker-entrypoint.sh: той правив би файли
    # у змонтованому conf.d, тобто в каталозі проєкту на хості.
    my @cmd = ('docker', 'run', '--rm', '--entrypoint', 'nginx', '--network', $network);
    push @cmd, map { ('-v', $_) } @mounts;
    push @cmd, $CFG{nginx_image}, '-t';

    return 1 if run(@cmd);

    die_err "згенерована конфігурація не проходить nginx -t. Робочий webserver НЕ чіпали,\n"
          . "       сайти живі зі старою конфігурацією в пам'яті.\n"
          . "       Якщо помилка про 'host not found in upstream' — перевірте, чи підняті\n"
          . '       контейнери доменів: на зупинених ця перевірка дає хибну тривогу.';
}

# Версія WordPress, яка реально лежить у web/. Сайт оновлює себе сам, тож
# вона розходиться з тегом образу — а тег вирішує, що розгорнеться, якщо
# каталог колись відновлять порожнім.
sub wp_installed_version {
    my ($domain) = @_;
    my $version_file = "$CFG{sites_root}/$domain/web/wp-includes/version.php";
    my $content = slurp($version_file) // return undef;
    my ($version) = $content =~ /\$wp_version\s*=\s*'([^']+)'/;
    return $version;
}

sub cert_dir  { my ($d) = @_; "$CFG{letsencrypt_dir}/etc/live/$d" }
sub cert_live { my ($d) = @_; -e cert_dir($d) . '/fullchain.pem' }

# ─────────────────────────── секрети ───────────────────────────

sub secret_path { my ($d) = @_; "$ROOT/secrets/$d.env" }

# '~' розкривається в домівку ефективного користувача з /etc/passwd, а не
# з $HOME: під sudo змінна оточення показує на кого завгодно, залежно від
# налаштувань sudoers, і ключ загубиться в чужій домівці.
sub master_key_path {
    my $path = $CFG{master_key_file};
    $path =~ s{^~(?=/|$)}{ (getpwuid($>))[7] // '/root' }e;
    return $path;
}

# Ключ створюється один раз і більше не змінюється: зміна зробить усі
# виведені паролі невідтворюваними, а в БД вони лишаться старими.
sub master_key {
    my $path = master_key_path();
    unless (-f $path) {
        open my $urandom, '<:raw', '/dev/urandom' or die_err 'немає /dev/urandom';
        read $urandom, my $bytes, 48;
        close $urandom;
        my $key = encode_base64($bytes, '');

        make_path(dirname($path)) unless -d dirname($path);
        open my $fh, '>', $path or die_err "не можу створити $path: $!";
        chmod 0400, $path;
        print $fh "$key\n";
        close $fh;

        say_warn "створено майстер-ключ $path (0400).";
        say_warn 'Це єдине, з чого відновлюються паролі БД усіх майбутніх доменів.';
        say_warn 'Покладіть копію в менеджер паролів — і НЕ змінюйте цей файл:';
        say_warn 'зміна зробить уже видані паролі невідтворюваними.';
    }
    open my $fh, '<', $path or die_err "не можу прочитати $path: $!";
    my $key = <$fh>;
    close $fh;
    chomp $key;
    die_err "майстер-ключ $path порожній" unless length $key;
    return $key;
}

# HMAC-SHA512(ключ, домен) у base64. '+', '/' і '=' прибираються, щоб
# пароль лишався тим самим рядком скрізь — у env_file, у healthcheck
# всередині подвійних лапок, у консолі mariadb.
#
# Той самий алгоритм, що й у tools/mkpass — результати мають збігатися.
sub derived_password {
    my ($domain) = @_;
    my $b64 = encode_base64(hmac_sha512($domain, master_key()), '');
    $b64 =~ tr{+/=}{}d;
    return substr($b64, 0, 48);
}

# Непорожній каталог даних = mariadb уже пройшла ініціалізацію і пароль
# із оточення більше не читає.
sub db_initialized {
    my ($domain) = @_;
    my $dir = "$CFG{sites_root}/$domain/db";
    return 0 unless -d $dir;
    opendir my $dh, $dir or return 0;
    my @entries = grep { !/^\.\.?$/ } readdir $dh;
    closedir $dh;
    return scalar @entries;
}

sub secret_ensure {
    my ($e) = @_;
    my $d    = $e->{domain};
    my $path = secret_path($d);
    return 0 if -f $path;

    my $mode = $e->{password_mode} // $CFG{password_mode};

    # База вже ініціалізована, а файла з паролем немає. Для derived це не
    # біда — виведемо той самий. Для random вигаданий новий пароль БД не
    # прийме: MariaDB бере MYSQL_PASSWORD лише при першому старті на
    # порожньому каталозі. Мовчки створити файл означало б підсунути
    # робочому сайту помилку автентифікації під виглядом полагодженого.
    if ($mode ne 'derived' && db_initialized($d)) {
        say_err "secrets/$d.env немає, а база в $CFG{sites_root}/$d/db вже існує "
              . 'і знає СТАРИЙ випадковий пароль.';
        say_err 'Новий тут не допоможе — його БД не прийме. Або відновіть файл із '
              . 'бекапу, або змініть пароль у самій БД:';
        say_err "  docker exec -it db-" . sid_of($d) . " mariadb -uroot -p"
              . '  →  ALTER USER ... IDENTIFIED BY ...';
        return 0;
    }

    my $pass = $mode eq 'derived' ? derived_password($d) : random_password();

    make_path("$ROOT/secrets") unless -d "$ROOT/secrets";
    chmod 0700, "$ROOT/secrets";
    write_file($path, secret_body($d, $pass, $mode), force => 1, mode => 0600, quiet => 1);
    say_ok "secrets/$d.env — створено (пароль: $mode, 48 символів)";
    return 1;
}

sub secret_body {
    my ($d, $pass, $mode) = @_;
    my $origin = ($mode // 'random') eq 'derived'
        ? "# Виведено з домену: HMAC-SHA512(майстер-ключ, $d).\n"
        . "# Відновлюється з ключа: dcpmgmt secrets restore\n"
        : "# Випадковий, нізвідки не відновлюється. Втратили файл —\n"
        . "# міняйте пароль у самій БД.\n";
    return "# Пароль БД для $d. Згенеровано dcpmgmt, у git не потрапляє.\n"
         . $origin
         . "# Підключається через env_file у docker-compose.domains/$d.yml.\n"
         . "# Зміна пароля тут НЕ змінює його в уже ініціалізованій БД —\n"
         . "# спершу ALTER USER у самій MariaDB, потім правка цього файла.\n"
         . "MYSQL_PASSWORD=$pass\n"
         . "WORDPRESS_DB_PASSWORD=$pass\n";
}

# ─────────────────────── генерація nginx-конфігів ───────────────────────

sub listen443_block {
    my ($e) = @_;
    my $d = $e->{domain};
    my @l;
    my $h3 = ($e->{http3} // 'on') eq 'on';
    if ($h3) {
        # reuseport на спільному порті 443 має стояти РІВНО в одному vhost
        # на весь стек, інакше nginx падає з "duplicate listen options",
        # показуючи при цьому на чужий файл (той, що вантажиться пізніше
        # за абеткою), а не на винуватця.
        my $ru = (lc($CFG{quic_reuseport_domain} // '') eq lc $d) ? ' reuseport' : '';
        # reuseport — властивість конкретного сокета, тож 0.0.0.0:443
        # і [::]:443 потребують його кожен окремо.
        push @l, "    listen 443 quic$ru;";
        push @l, "    listen [::]:443 quic$ru;";
    }
    push @l, '    listen 443 ssl;';
    push @l, '    listen [::]:443 ssl;';
    push @l, '    http2 on;';
    if ($h3) {
        push @l, '    http3 on;';
        push @l, '    quic_gso on;';
        push @l, '    quic_retry on;';
    }
    return join "\n", @l;
}

sub alt_svc_line {
    my ($e) = @_;
    return '' unless ($e->{http3} // 'on') eq 'on';
    # h3-29 (draft-29) nginx не вміє взагалі — рекламувати його означає
    # посилати клієнта у версію, якої на сокеті немає.
    # ma=3600, а не доба: якщо HTTP/3 зламається, клієнти відліпляться
    # від нього за годину, а не за добу.
    # always — щоб Alt-Svc був і у відповідях 4xx/5xx.
    return qq{    add_header Alt-Svc 'h3=":443"; ma=3600' always;\n};
}

sub nginx_conf_path { my ($d) = @_; "$ROOT/nginx/nginx-$d.conf" }

sub nginx_conf_body {
    my ($e) = @_;
    my $d    = $e->{domain};
    my %v = (
        domain     => $d,
        webroot    => "/var/www/html/$d",
        listen443  => listen443_block($e),
        alt_svc    => alt_svc_line($e),
        target     => $e->{target}      // '',
        upstream   => $e->{upstream}    // '',
        php_service=> $e->{php_service} // ('wordpress-' . sid_of($d)),
    );
    # Поки сертифіката фізично немає — віддаємо :80-заглушку. ssl_certificate
    # на неіснуючий файл валить увесь nginx, а не тільки цей сайт, тож
    # згенерований конфіг НІКОЛИ не посилається на відсутній сертифікат.
    return render_template('nginx-bootstrap.conf.tmpl', %v) unless cert_live($d);
    return render_template("nginx-$e->{type}.conf.tmpl", %v);
}

# ─────────────────────── генерація docker-compose ───────────────────────

sub domain_yml_path { my ($d) = @_; "$ROOT/docker-compose.domains/$d.yml" }

# Файл домену включається в стек, тільки якщо він існує і вже заповнений:
# каркас proxy-сайту з CHANGE-ME навмисно лишається поза стеком, щоб
# `docker compose up` не спіткнувся об неіснуючий образ.
sub domain_yml_ready {
    my ($d) = @_;
    my $c = slurp(domain_yml_path($d));
    return 0 unless defined $c;
    return 0 if $c =~ /CHANGE-ME/;
    return 1;
}

sub domain_yml_body {
    my ($e) = @_;
    my $d = $e->{domain};
    return undef if $e->{type} eq 'redirect';   # редіректу контейнер не потрібен
    my %v = (
        domain     => $d,
        sid        => sid_of($d),
        sites_root => $CFG{sites_root},
        wp_image   => $e->{image}    || $CFG{wordpress_image},
        db_image   => $e->{db_image} || $CFG{db_image},
        db_ping    => db_ping_cmd($e->{db_image} || $CFG{db_image}),
        db_name    => $e->{db_name}  || db_name_of($d),
        db_user    => $e->{db_user}  || db_user_of($d),
        upstream   => $e->{upstream} // '',
        app_service=> $e->{app_service} || upstream_host($e->{upstream} // ''),
        extra_env  => extra_env_lines($e),
        php_ini    => php_ini_mounts($e),
    );
    return render_template('domain-wordpress.yml.tmpl', %v) if $e->{type} eq 'wordpress';
    return render_template('domain-proxy.yml.tmpl', %v);
}

# Клієнт для healthcheck залежить від того, що за СУБД в образі: MariaDB
# з 11.x перейменувала mysqladmin на mariadb-admin, а в образах MySQL
# mariadb-admin немає взагалі — healthcheck мовчки провалюється, і
# WordPress не стартує через depends_on: service_healthy.
sub db_ping_cmd {
    my ($image) = @_;
    return $image =~ m{^(?:.*/)?mysql[:@]} ? 'mysqladmin' : 'mariadb-admin';
}

# Додаткові змінні оточення WordPress-контейнера, яких немає в схемі:
# у реєстрі — рядок "KEY=value, KEY2=value2", у yml — рядки environment.
# Потрібні для таких речей, як PHP_DISPLAY_ERRORS на сайті в розробці.
sub extra_env_lines {
    my ($e) = @_;
    return '' unless $e->{extra_env};
    my @lines;
    for my $pair (split /\s*,\s*/, $e->{extra_env}) {
        my ($key, $value) = $pair =~ /^([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)$/ or next;
        push @lines, sprintf('      %s: "%s"', $key, $value);
    }
    return @lines ? "\n" . join("\n", @lines) : '';
}

# PHP-налаштування домену живуть поруч із сайтом: усе, що лежить у
# <sites_root>/<домен>/php/*.ini, монтується в conf.d контейнера. Це та
# сама ідея, що й nginx/custom/<домен>.conf — правка переживає
# render --force, і перелічувати її в реєстрі не треба.
#
# Файли монтуються поштучно, а не каталогом: монт каталогу поверх
# conf.d сховав би те, що поклав туди образ (opcache, error-logging).
# PHP читає conf.d за абеткою, тож файл, який має перекрити налаштування
# образу, називають так, щоб він сортувався пізніше.
sub php_ini_mounts {
    my ($e) = @_;
    my @lines = map { sprintf('      - %s:/usr/local/etc/php/conf.d/%s:ro', $_, basename($_)) }
                sort glob("$CFG{sites_root}/$e->{domain}/php/*.ini");
    return @lines ? "\n" . join("\n", @lines) : '';
}

sub upstream_host {
    my ($u) = @_;
    $u =~ s/:\d+$//;
    return $u;
}

# Webroot домену так, як його бачать webserver і certbot.
#   WordPress — named volume: той самий каталог ділять php-fpm і nginx,
#               оголошення bind'а живе в одному місці (файлі домену).
#   redirect/proxy — прямий bind: контейнера-власника немає взагалі.
sub webroot_mount {
    my ($e, $ro) = @_;
    my $d = $e->{domain};
    return 'wordpress-' . sid_of($d) . ":/var/www/html/$d" if $e->{type} eq 'wordpress';
    return "$CFG{sites_root}/$d/web:/var/www/html/$d" . ($ro ? ':ro' : '');
}

sub main_nginx_conf_path { "$ROOT/nginx/nginx.conf" }

sub quic_bpf_enabled { lc($CFG{quic_bpf} // 'off') eq 'on' }

sub main_nginx_conf_body {
    return render_template('nginx.conf.tmpl',
        worker_processes => $CFG{worker_processes},
        quic_bpf         => quic_bpf_enabled() ? "quic_bpf on;\n" : '',
    );
}

sub compose_main_body {
    my (@doms) = @_;
    my (@deps, @wsvol, @cbvol);
    for my $e (@doms) {
        my $d = $e->{domain};
        push @deps, '      - wordpress-' . sid_of($d) if $e->{type} eq 'wordpress';
        push @deps, "      - $e->{app_service}"
            if $e->{type} eq 'proxy' && $e->{app_service} && domain_yml_ready($d);
        push @wsvol, "      - ./nginx/nginx-$d.conf:/etc/nginx/conf.d/$d.conf:ro";
        push @wsvol, '      - ' . webroot_mount($e, 1);
        push @cbvol, '      - ' . webroot_mount($e, 0);
    }
    my $deps = @deps ? "    depends_on:\n" . join("\n", @deps) : '';
    # Власний головний конфіг, якщо він є. Директиви головного контексту
    # (quic_bpf, worker_processes) у conf.d не працюють — лише тут.
    unshift @wsvol, '      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro'
        if -f main_nginx_conf_path();
    my %v = (
        %CFG,
        webserver_depends    => $deps,
        webserver_volumes    => join("\n", @wsvol),
        webserver_privileges => webserver_privileges(),
        certbot_volumes      => join("\n", @cbvol),
    );
    my $body = render_template('compose-main.yml.tmpl', %v);
    # Порожній {{webserver_depends}} (стек без жодного контейнерного домену)
    # лишає по собі зайвий порожній рядок посеред YAML.
    $body =~ s/\n\n+/\n\n/g;
    return $body;
}

# nginx вантажить eBPF-програму сам, зсередини контейнера. Типовий профіль
# seccomp у docker блокує виклик bpf() усім, крім CAP_SYS_ADMIN, тож самих
# лише capabilities замало — профіль доводиться послабити.
sub webserver_privileges {
    return '' unless quic_bpf_enabled();
    return join "\n",
        '    cap_add:',
        '      - BPF',
        '      - NET_ADMIN',
        '    security_opt:',
        '      - seccomp:unconfined';
}

sub compose_root_body {
    my (@doms) = @_;
    my @inc = map  { "  - docker-compose.domains/$_->{domain}.yml" }
              grep { domain_yml_ready($_->{domain}) } @doms;
    return render_template('compose-root.yml.tmpl',
        project  => $CFG{project},
        includes => join("\n", @inc),
    );
}

# ─────────────────────────── render ───────────────────────────

sub ensure_site_dirs {
    my ($e) = @_;
    my $d = $e->{domain};
    for my $sub ($e->{type} eq 'wordpress' ? ('web', 'db') : ('web')) {
        my $p = "$CFG{sites_root}/$d/$sub";
        next if -d $p;
        make_path($p) or die_err "не можу створити $p: $!";
        # web-корінь WordPress віддаємо www-data (uid/gid 33 у Debian-образах):
        # php-fpm пише туди оновлення й завантаження. Каталог БД чіпати не
        # треба — mariadb сама перебирає його на себе при першому старті.
        chown(33, 33, $p) if $sub eq 'web' && $e->{type} eq 'wordpress' && $> == 0;
        say_ok "створено $p";
    }
}

# Наявний yml міг обрости змінними оточення руками. Регенерація їх зітре
# мовчки, а наслідок (сайт поводиться інакше) виявиться геть не одразу.
sub warn_dropped_env {
    my ($e, $generated) = @_;
    my $current = slurp(domain_yml_path($e->{domain})) // return;
    # Паролі не «зникають»: вони навмисно переїхали в secrets/*.env і
    # підключаються через env_file. Радити повернути їх у yml означало б
    # радити покласти пароль у файл, який може потрапити в git.
    my %moved_to_secrets = map { $_ => 1 } qw(WORDPRESS_DB_PASSWORD MYSQL_PASSWORD);
    my %in_new = map { $_ => 1 } $generated =~ /^\s{6}([A-Z_][A-Z0-9_]*):/mg;
    my @dropped = grep { !$in_new{$_} && !$moved_to_secrets{$_} }
                  $current =~ /^\s{6}([A-Z_][A-Z0-9_]*):/mg;
    return unless @dropped;
    say_warn "docker-compose.domains/$e->{domain}.yml: у наявному файлі є змінні, "
           . 'яких немає в згенерованому: ' . join(', ', @dropped) . '.';
    say_warn "Щоб не загубити, додайте в domains/$e->{domain}.conf рядок на кшталт:";
    say_warn '  extra_env   = ' . join(', ', map { "$_=значення" } @dropped);
}

sub ensure_custom_hooks {
    my ($e) = @_;
    my $d = $e->{domain};
    for my $hook ("$ROOT/nginx/custom/$d.conf",
                  ($e->{type} eq 'wordpress' ? "$ROOT/nginx/custom/$d.php.conf" : ())) {
        next if -f $hook;
        write_file($hook,
            "# Правки для $d, які переживають `dcpmgmt render --force`.\n"
          . "# Цей файл dcpmgmt не перезаписує ніколи. Порожній — це нормально.\n",
            quiet => 1);
    }
}

# Лише nginx-конфіг одного домену. Після видачі сертифіката треба замінити
# :80-заглушку на бойовий конфіг — і більше нічого: перебудовувати
# compose-файли всього стека заради сертифіката одного домену означає
# підсунути під працюючі контейнери зміни, яких ніхто не просив.
sub render_domain_nginx {
    my ($e, %o) = @_;
    ensure_custom_hooks($e);
    write_file(nginx_conf_path($e->{domain}), nginx_conf_body($e), %o);
}

sub render_all {
    my (%o) = @_;
    my @all  = reg_enabled();
    my %only = map { $_ => 1 } @{ $o{only} || [] };
    # Файли генеруються для @doms (можливо, одного домену), а зведені
    # docker-compose.yml і .main.yml — завжди для всього реєстру.
    my @doms = %only ? grep { $only{$_->{domain}} } @all : @all;

    for my $e (@doms) {
        my $d = $e->{domain};
        ensure_site_dirs($e) unless $o{no_dirs};
        secret_ensure($e) if $e->{type} eq 'wordpress';

        ensure_custom_hooks($e);
        my $nginx_conf = nginx_conf_body($e);
        report_lost_directives(nginx_conf_path($d), $nginx_conf)
            if $o{diff} && -f nginx_conf_path($d);
        write_file(nginx_conf_path($d), $nginx_conf, %o);
        if ($e->{type} eq 'redirect') {
            my $idx = "$CFG{sites_root}/$d/web/index.html";
            write_file($idx, render_template('redirect-index.html.tmpl', target => $e->{target}), %o)
                unless $o{no_dirs};
        }
        my $yml = domain_yml_body($e);
        if (defined $yml) {
            # Файл proxy-домену описує ЧУЖИЙ застосунок і належить адміну:
            # --force регенерує наші шаблони, а не чужу роботу. Щоб отримати
            # свіжий каркас — видаліть файл і повторіть render.
            warn_dropped_env($e, $yml) if $e->{type} eq 'wordpress';
            my %fo = $e->{type} eq 'proxy' ? (%o, force => 0, owned_by_admin => 1) : %o;
            write_file(domain_yml_path($d), $yml, %fo);
        }
        elsif (-f domain_yml_path($d)) {
            # redirect обслуговує сам nginx: контейнер-пустушка (alpine у
            # вічному sleep) існував лише щоб створити named volume.
            if ($o{force}) {
                rename domain_yml_path($d), domain_yml_path($d) . '.bak';
                say_ok "docker-compose.domains/$d.yml — прибрано (редіректу контейнер не потрібен), копія в .bak";
            } else {
                say_warn "docker-compose.domains/$d.yml зайвий: редірект обслуговує nginx, "
                       . 'контейнер не потрібен (--force прибере, зберігши .bak)';
            }
        }
    }

    if (quic_bpf_enabled()) {
        write_file(main_nginx_conf_path(), main_nginx_conf_body(), %o);
        say_warn 'quic_bpf = on: webserver отримує CAP_BPF, CAP_NET_ADMIN і '
               . 'seccomp:unconfined — це контейнер, що дивиться в інтернет.';
        say_warn 'Одразу після apply перевірте `docker logs webserver`: якщо ядро '
               . 'або docker не дають bpf(), nginx не підніметься, а він один на всі домени.';
        say_warn 'Відкат: quic_bpf = off у dcp.conf, потім dcpmgmt apply.';
    }

    # ці два файли повністю належать інструменту — завжди перезаписуються
    my %own = (%o, force => 1);
    write_file("$ROOT/docker-compose.main.yml", compose_main_body(@all), %own);
    write_file("$ROOT/docker-compose.yml",      compose_root_body(@all), %own);

    for my $e (@all) {
        next unless $e->{type} eq 'proxy';
        next if domain_yml_ready($e->{domain});
        say_warn "docker-compose.domains/$e->{domain}.yml ще містить CHANGE-ME — "
               . "домен поза стеком, nginx для нього не підніметься (host not found in upstream)";
    }
}

# ─────────────────────────── сертифікати ───────────────────────────

sub cert_issue {
    my ($d, %o) = @_;
    if (cert_live($d) && !$o{force}) {
        say_ok "сертифікат для $d вже є — видачу пропущено";
        return 1;
    }
    unless (container_running('webserver')) {
        die_err "webserver не працює, а Let's Encrypt має достукатись до\n"
              . "       http://$d/.well-known/acme-challenge/. Спершу: dcpmgmt apply";
    }
    say_step "Первинна видача сертифіката для $d";
    say_info 'вимоги: A/AAAA-запис уже вказує на цей сервер, порт 80 доступний ззовні,';
    say_info 'а якщо домен за Cloudflare — проксі поки вимкнено (сіра хмарка).';

    # Одноразовий контейнер, а не `docker exec` у certbot: той сидить у циклі
    # renew і тримає lock — exec впаде з "Another instance of Certbot is
    # already running". Монтуємо шляхи хоста напряму, щоб не залежати від
    # префікса імені compose-проєкту в назвах volume'ів.
    my @cmd = (
        'docker', 'run', '--rm',
        '-v', "$CFG{letsencrypt_dir}/etc:/etc/letsencrypt",
        '-v', "$CFG{letsencrypt_dir}/var:/var/lib/letsencrypt",
        '-v', "$CFG{sites_root}/$d/web:/var/www/html/$d",
        $CFG{certbot_image}, 'certonly', '--webroot',
        '--webroot-path', "/var/www/html/$d",
        '-d', $d,
        '--email', $CFG{certbot_email},
        '--agree-tos', '--no-eff-email', '--non-interactive',
    );
    push @cmd, '--staging'      if $o{staging};
    push @cmd, '--force-renewal' if $o{force};

    unless (run(@cmd)) {
        die_err "certbot не видав сертифікат для $d.\n"
              . "       Найчастіші причини: DNS ще не вказує сюди; порт 80 закрито;\n"
              . "       Cloudflare-проксі увімкнено; вичерпано ліміт Let's Encrypt\n"
              . "       (5 невдалих валідацій/год, 50 сертифікатів/тиждень на домен).\n"
              . "       Ліміти НЕ обходяться повторами наосліп — розберіться з причиною.\n"
              . "       Для перевірки без витрати лімітів: dcpmgmt cert issue $d --staging";
    }
    say_ok "сертифікат для $d отримано";
    return 1;
}

sub cmd_cert {
    my @args = @_;
    load_config();
    my $sub = shift @args // '';
    my ($staging, $force, $dry_run) = (0, 0, 0);
    GetOptionsFromArray(\@args, 'staging' => \$staging, 'force' => \$force,
                        'dry-run' => \$dry_run)
        or die_err 'невідомий ключ';
    my $d = shift @args;

    if ($sub eq 'issue') {
        die_err 'потрібен домен: dcpmgmt cert issue <domain>' unless $d;
        my $e = reg_load_one($d) or die_err "домену $d немає в реєстрі";
        cert_issue($d, staging => $staging, force => $force);
        render_domain_nginx($e, force => 1);
        nginx_test_reload();
    }
    elsif ($sub eq 'renew') {
        my @doms = $d ? ($d) : map { $_->{domain} } reg_enabled();
        for my $dom (@doms) {
            my @cmd = (
                'docker', 'run', '--rm',
                '-v', "$CFG{letsencrypt_dir}/etc:/etc/letsencrypt",
                '-v', "$CFG{letsencrypt_dir}/var:/var/lib/letsencrypt",
                '-v', "$CFG{sites_root}/$dom/web:/var/www/html/$dom",
                $CFG{certbot_image}, 'renew', '--cert-name', $dom,
            );
            # --dry-run ходить на тестовий сервер і нічого не записує:
            # єдиний спосіб перевірити, чи подовження взагалі пройде, не
            # витрачаючи лімітів Let's Encrypt.
            push @cmd, '--dry-run'       if $dry_run;
            push @cmd, '--force-renewal' if $force;
            run(@cmd) or say_warn "renew для $dom завершився помилкою";
        }
        nginx_test_reload() unless $dry_run;
    }
    elsif ($sub eq 'list') {
        for my $e (reg_all()) {
            my $d2 = $e->{domain};
            printf "  %-34s %s\n", $d2, cert_expiry($d2) // c('1;31', 'сертифіката немає');
        }
    }
    else {
        die_err 'dcpmgmt cert issue|renew|list [<domain>] [--staging] [--force] [--dry-run]';
    }
}

# `openssl x509 -checkend` замість розбору дати: сам вміє порівнювати з
# поточним часом і не залежить від локалі й формату notAfter.
sub cert_expires_within {
    my ($domain, $seconds) = @_;
    my $pem = cert_dir($domain) . '/cert.pem';
    return 0 unless -e $pem;
    return !run_quiet('openssl', 'x509', '-checkend', $seconds, '-noout', '-in', $pem);
}

sub cert_expiry {
    my ($d) = @_;
    my $pem = cert_dir($d) . '/cert.pem';
    return undef unless -e $pem;
    my $out = capture('openssl', 'x509', '-enddate', '-noout', '-in', $pem);
    my ($date) = $out =~ /notAfter=(.+)/;
    return $date ? "діє до $date" : 'сертифікат є';
}

# ─────────────────────────── команди ───────────────────────────

sub cmd_init {
    my @args = @_;
    say_step 'Ініціалізація проєкту';
    unless (-f "$ROOT/dcp.conf") {
        my $ex = slurp("$ROOT/dcp.conf.example") or die_err 'немає dcp.conf.example';
        write_file("$ROOT/dcp.conf", $ex, mode => 0600);
        say_warn 'створено dcp.conf із прикладу — ВИПРАВТЕ certbot_email і project, потім повторіть init';
        exit 0;
    }
    load_config();

    for my $d (reg_dir(), "$ROOT/secrets", "$ROOT/nginx/custom",
               "$ROOT/docker-compose.domains",
               $CFG{sites_root}, $CFG{nginx_conf_dir},
               "$CFG{letsencrypt_dir}/etc", "$CFG{letsencrypt_dir}/var") {
        next if -d $d;
        make_path($d) or die_err "не можу створити $d: $!";
        say_ok "створено $d";
    }
    chmod 0700, "$ROOT/secrets";

    render_all();
    say_ok 'структура готова';
    print <<"TXT";

Далі:
  dcpmgmt add wordpress example.com      — повноцінний сайт
  dcpmgmt add redirect old.example.com --to example.com
  dcpmgmt add proxy api.example.com --upstream my-app:8080
  dcpmgmt apply                          — підняти стек

Успадкована інсталяція (стек уже працює, файли є):
  dcpmgmt import      — зібрати реєстр із наявних конфігів, нічого не ламаючи
TXT
}

# Стек ходить у WordPress через fastcgi_pass :9000, тож потрібен саме
# fpm-варіант образу. wordpress:latest — це апачевий образ (той самий
# digest, що й wordpress:apache): він слухає HTTP на 80 і про FastCGI не
# знає, тож домен віддаватиме 502 одразу після apply.
sub image_not_fpm {
    my ($image) = @_;
    return $image !~ m{(?:^|[:-])fpm(?:-|$)};
}

sub cmd_add {
    my @args = @_;
    my $type = shift @args // '';
    die_err 'тип має бути wordpress | redirect | proxy'
        unless $type =~ /^(wordpress|redirect|proxy)$/;

    my ($target, $upstream, $image, $http3, $no_cert, $staging) = ('', '', '', 'on', 0, 0);
    GetOptionsFromArray(\@args,
        'to=s'       => \$target,
        'upstream=s' => \$upstream,
        'image=s'    => \$image,
        'http3!'     => sub { $http3 = $_[1] ? 'on' : 'off' },
        'no-cert'    => \$no_cert,
        'staging'    => \$staging,
    ) or die_err 'невідомий ключ';

    my $d = lc(shift(@args) // '');
    die_err 'потрібне ім\'я домену' unless $d;
    die_err "'$d' не схоже на ім'я домену (для кирилиці вживайте punycode: xn--...)"
        unless valid_domain($d);
    die_err "домен $d уже є в реєстрі (domains/$d.conf)" if reg_load_one($d);
    die_err 'redirect потребує --to <домен-призначення>' if $type eq 'redirect' && !$target;
    die_err 'proxy потребує --upstream <host:port>'      if $type eq 'proxy'    && !$upstream;
    die_err "--to <domain>: '$target' не схоже на домен"
        if $target && !valid_domain($target);

    load_config();

    die_err "--image '$image': стеку потрібен fpm-варіант образу "
          . "(wordpress:php8.4-fpm). wordpress:latest — це апачевий образ, "
          . "він не слухає FastCGI на :9000, і домен віддаватиме 502"
        if $type eq 'wordpress' && $image && image_not_fpm($image);

    my $e = {
        domain => $d, type => $type, http3 => $http3, enabled => 'yes',
        ($target   ? (target   => $target)   : ()),
        ($upstream ? (upstream => $upstream, app_service => upstream_host($upstream)) : ()),
        ($image    ? (image    => $image)    : ()),
    };
    if ($type eq 'wordpress') {
        $e->{db_name}     = db_name_of($d);
        $e->{db_user}     = db_user_of($d);
        $e->{php_service} = 'wordpress-' . sid_of($d);
        $e->{image}     ||= $CFG{wordpress_image};
    }
    $e->{password_mode} = $CFG{password_mode} if $type eq 'wordpress';
    reg_save($e);
    say_ok "domains/$d.conf — створено";

    say_step "Крок 1/4: файли та структура";
    render_all(only => [$d]);

    say_step 'Крок 2/4: піднімаємо стек (nginx поки з :80-заглушкою для нового домену)';
    compose('up', '-d', '--remove-orphans') or die_err 'docker compose up завершився помилкою';
    nginx_test_reload();

    unless ($no_cert) {
        say_step 'Крок 3/4: сертифікат';
        cert_issue($d, staging => $staging);
        say_step 'Крок 4/4: бойовий nginx-конфіг з 443';
        render_all(force => 1, only => [$d]);
        compose('up', '-d', '--remove-orphans');
        nginx_test_reload();
    } else {
        say_warn 'видачу сертифіката пропущено (--no-cert): домен віддає :80-заглушку.';
        say_warn "коли DNS буде готовий — dcpmgmt cert issue $d";
    }

    print "\n";
    if ($type eq 'wordpress') {
        say_ok "готово: https://$d/wp-admin/install.php — лишилось пройти майстер WordPress";
        say_info "БД, користувач і пароль уже створені й прописані у wp-config.php;";
        say_info 'майстер спитає лише назву сайту й адміна.';
    } elsif ($type eq 'redirect') {
        say_ok "готово: https://$d/ -> https://$target/ (301, плюс index.html як підстраховка)";
    } else {
        say_ok "готово: https://$d/ -> http://$upstream/";
        say_info "опишіть сервіс застосунку в docker-compose.domains/$d.yml (заміна CHANGE-ME),";
        say_info 'потім: dcpmgmt apply';
    }
}

sub cmd_remove {
    my @args = @_;
    my $purge = 0;
    GetOptionsFromArray(\@args, 'purge' => \$purge) or die_err 'невідомий ключ';
    my $d = lc(shift(@args) // '');
    die_err 'потрібне ім\'я домену' unless $d;
    load_config();
    my $e = reg_load_one($d) or die_err "домену $d немає в реєстрі";

    my $what = $purge
        ? "домен $d РАЗОМ з файлами $CFG{sites_root}/$d (web + база даних!) і сертифікатом"
        : "домен $d зі стека (файли $CFG{sites_root}/$d і сертифікат ЛИШАЮТЬСЯ)";
    confirm("Видалити $what?") or do { say_info 'скасовано'; return };

    my $sid = sid_of($d);
    my @svc = $e->{type} eq 'wordpress' ? ("wordpress-$sid", "db-$sid")
            : $e->{type} eq 'proxy' && $e->{app_service} ? ($e->{app_service}) : ();
    if (@svc) {
        compose('stop', @svc);
        compose('rm', '-f', '-v', @svc);
    }

    unlink reg_path($d), nginx_conf_path($d), domain_yml_path($d);
    unlink "$ROOT/nginx/custom/$d.conf", "$ROOT/nginx/custom/$d.php.conf";
    say_ok "реєстр і згенеровані конфіги для $d прибрано";

    render_all();
    compose('up', '-d', '--remove-orphans');
    nginx_test_reload();

    if ($purge) {
        run('docker', 'run', '--rm',
            '-v', "$CFG{letsencrypt_dir}/etc:/etc/letsencrypt",
            '-v', "$CFG{letsencrypt_dir}/var:/var/lib/letsencrypt",
            $CFG{certbot_image}, 'delete', '--cert-name', $d, '--non-interactive');
        remove_tree("$CFG{sites_root}/$d");
        unlink secret_path($d);
        say_ok "прибрано $CFG{sites_root}/$d, сертифікат і secrets/$d.env";
    } else {
        say_info "дані лишились: $CFG{sites_root}/$d, secrets/$d.env, сертифікат у letsencrypt";
        say_info "повне прибирання: dcpmgmt remove $d --purge (спершу поверніть домен у реєстр)";
    }
}

sub cmd_list {
    my @args = @_;
    my ($names, $type) = (0, '');
    GetOptionsFromArray(\@args, 'names' => \$names, 'type=s' => \$type)
        or die_err 'невідомий ключ';
    load_config();
    my @doms = reg_all();
    @doms = grep { $_->{type} eq $type } @doms if $type;
    if ($names) {                       # для скриптів: по домену на рядок
        print "$_->{domain}\n" for @doms;
        return;
    }
    unless (@doms) { say_info 'реєстр порожній — почніть з dcpmgmt add ... або dcpmgmt import'; return }
    printf "%-34s %-10s %-28s %-5s %s\n", 'ДОМЕН', 'ТИП', 'ПРИЗНАЧЕННЯ', 'H3', 'СЕРТИФІКАТ';
    for my $e (@doms) {
        my $d = $e->{domain};
        my $dest = $e->{type} eq 'redirect' ? "-> $e->{target}"
                 : $e->{type} eq 'proxy'    ? "-> $e->{upstream}"
                 : ($e->{image} // '');
        printf "%-34s %-10s %-28s %-5s %s\n",
            $d, $e->{type}, $dest, ($e->{http3} eq 'on' ? 'так' : 'ні'),
            (cert_live($d) ? 'є' : c('1;31', 'НЕМАЄ'));
    }
}

sub cmd_render {
    my @args = @_;
    my ($force, $diff) = (0, 0);
    GetOptionsFromArray(\@args, 'force' => \$force, 'diff' => \$diff)
        or die_err 'невідомий ключ';
    load_config();
    render_all(force => $force, diff => $diff, (@args ? (only => \@args) : ()));
    say_info 'застосувати до працюючого стека: dcpmgmt apply' unless $diff;
}

# Хеш кожного сервісу з поточної конфігурації compose. Саме за ним compose
# вирішує, чи перестворювати контейнер — тож порівняння «до/після» точно
# відповідає на питання «що саме смикне apply».
sub service_hashes {
    return {} unless have_docker();
    chdir $ROOT;
    return {} unless -f "$ROOT/docker-compose.yml";
    my $out = capture('docker', 'compose', 'config', '--hash=*');
    my %h;
    for my $l (split /\n/, $out) {
        my ($s, $hash) = $l =~ /^(\S+)\s+(\S+)$/ or next;
        $h{$s} = $hash;
    }
    return \%h;
}

# Хеш конфігурації, з яким кожен контейнер був СТВОРЕНИЙ — compose пише
# його в мітку і саме з ним звіряється, вирішуючи, чи перестворювати.
# Порівнювати треба з ним, а не з попереднім станом файлів: якщо файли
# перегенерували раніше й окремо, різниця «до/після» буде нульова, а
# контейнери все одно поїдуть на перестворення.
sub running_service_hashes {
    return {} unless have_docker();
    my $out = capture('docker', 'ps', '-a',
        '--filter', "label=com.docker.compose.project=$CFG{project}",
        '--format', '{{.Label "com.docker.compose.service"}} {{.Label "com.docker.compose.config-hash"}}');
    my %hashes;
    for my $line (split /\n/, $out) {
        my ($service, $hash) = $line =~ /^(\S+)\s+(\S+)$/ or next;
        $hashes{$service} = $hash;
    }
    return \%hashes;
}

sub report_impact {
    my ($before, $after) = @_;
    return 0 unless %$before || %$after;
    my (@new, @gone, @changed);
    for my $s (sort keys %$after) {
        push @new, $s unless exists $before->{$s};
    }
    for my $s (sort keys %$before) {
        if (!exists $after->{$s})              { push @gone, $s }
        elsif ($before->{$s} ne $after->{$s})  { push @changed, $s }
    }
    say_step 'Що зробить apply з контейнерами';
    say_ok 'нічого не перестворюється' unless @new || @gone || @changed;
    say_info 'створити:      ' . join(', ', @new)     if @new;
    say_info 'перестворити:  ' . join(', ', @changed) if @changed;
    say_info 'прибрати:      ' . join(', ', @gone)    if @gone;
    if (grep { /^db-/ } @changed) {
        say_warn 'серед них є контейнери БД. Дані лежать на хості в '
               . "$CFG{sites_root}/<домен>/db і нікуди не діваються,";
        say_warn 'але сайт на час перестворення (кілька секунд) віддаватиме помилку БД.';
    }
    return scalar(@new) + scalar(@gone) + scalar(@changed);
}

sub cmd_apply {
    my @args = @_;
    my $force = 0;
    GetOptionsFromArray(\@args, 'force' => \$force) or die_err 'невідомий ключ';
    load_config();

    my $running = running_service_hashes();
    say_step 'Генерація конфігурації з реєстру';
    render_all(force => $force);
    my $desired = service_hashes();

    if (%$running) {
        report_impact($running, $desired);
    } else {
        say_step 'Що зробить apply з контейнерами';
        say_info 'стек не запущено — підніметься все, що описано в конфігурації';
    }

    unless (confirm('Застосувати до працюючого стека?')) { say_info 'скасовано'; return }
    preflight_nginx(reg_enabled());
    compose('up', '-d', '--remove-orphans') or die_err 'docker compose up завершився помилкою';
    nginx_test_reload();
    say_ok 'готово';
}

# ────────────────────── життєвий цикл контейнерів ──────────────────────
#
# up/down/restart — це про ЖИВІ контейнери, а не про склад стека. Нічого
# не генерується й не перезаписується: змінити склад — це apply.

# Контейнери, якими керують up/down/restart. Redirect-домен не має їх
# зовсім: він живе рядками в nginx-конфізі.
sub domain_services {
    my ($e) = @_;
    return ('db-' . sid_of($e->{domain}), 'wordpress-' . sid_of($e->{domain}))
        if $e->{type} eq 'wordpress';
    return ($e->{app_service}) if $e->{type} eq 'proxy' && $e->{app_service};
    return ();
}

sub cmd_lifecycle {
    my ($action, @args) = @_;
    load_config();
    my $d = lc(shift(@args) // '');

    my %verb = (up => 'піднімаємо', down => 'зупиняємо', restart => 'перезапускаємо');

    unless ($d) {
        say_step "$verb{$action}: весь стек";
        # down на весь стек — це саме `compose down`: контейнери зникають
        # разом із мережею проєкту. Не `network prune`, який вимів би й
        # чужі невживані мережі на цьому хості. Дані не страждають: усі
        # volume'и названі й bind-backed, а `-v` стосується лише анонімних,
        # яких у наших шаблонах немає.
        my @cmd = $action eq 'up'   ? ('up', '-d')
                : $action eq 'down' ? ('down', '--remove-orphans')
                :                     ('restart');
        if ($action eq 'down') {
            say_warn 'зупиняться ВСІ домени цього стека разом з nginx — сайти стануть недоступні';
            return say_info 'скасовано' unless confirm('Зупинити весь стек?');
        }
        compose(@cmd) or die_err "docker compose $cmd[0] завершився помилкою";
        # Після down стека nginx уже немає — перевіряти конфіг нема кому.
        nginx_test_reload() unless $action eq 'down';
        say_ok 'готово';
        return;
    }

    my $e = reg_load_one($d) or die_err "домену $d немає в реєстрі (domains/$d.conf)";
    my @svc = domain_services($e);
    unless (@svc) {
        say_info "$d — тип $e->{type}: власних контейнерів не має зовсім, "
               . 'він живе рядками в nginx-конфізі.';
        say_info 'перезапускати тут нічого; змінити його — render, потім apply';
        return;
    }

    if ($action eq 'down') {
        say_warn "поки $d зупинений, nginx віддаватиме на ньому 502 — решта сайтів працює";
        say_warn 'render і apply у цей час спотикатимуться на перевірці конфігу: '
               . 'nginx не резолвить зупинений upstream';
        return say_info 'скасовано' unless confirm("Зупинити $d?");
    }

    say_step "$verb{$action}: $d (" . join(', ', @svc) . ')';
    my @cmd = $action eq 'up'   ? ('up', '-d', @svc)
            : $action eq 'down' ? ('stop', @svc)
            :                     ('restart', @svc);
    compose(@cmd) or die_err "docker compose $cmd[0] завершився помилкою";

    # nginx резолвить fastcgi_pass і proxy_pass на старті воркерів і тримає
    # адресу до наступного reload. Перестворений контейнер отримує іншу IP,
    # і без reload nginx стукає у стару — 502 на домені, який щойно підняли.
    nginx_test_reload() unless $action eq 'down';
    say_ok 'готово';
}

# ─────────────────────────── import ───────────────────────────
#
# Успадкована інсталяція: стек уже працює, реєстру ще немає. Збираємо
# реєстр із того, що є на диску, і НІЧОГО не змінюємо — ні контейнерів,
# ні конфігів. Перевірити наслідки потім: dcpmgmt render --diff.

sub parse_nginx_conf {
    my ($path, $domain) = @_;
    my $c = nginx_uncommented($path) // return undef;
    my %e = (domain => $domain, enabled => 'yes');
    $e{http3} = $c =~ /^\s*http3\s+on;/m ? 'on' : 'off';
    $e{_reuseport} = $c =~ /reuseport/ ? 1 : 0;

    if (my ($php) = $c =~ /fastcgi_pass\s+([\w.-]+):9000;/) {
        $e{type} = 'wordpress';
        $e{php_service} = $php;
    }
    elsif (my ($up) = $c =~ m{proxy_pass\s+https?://([\w.:-]+)/?;}) {
        $e{type} = 'proxy';
        $e{upstream} = $up;
        $e{app_service} = upstream_host($up);
    }
    else {
        $e{type} = 'redirect';
        my ($t) = grep { $_ ne $domain }
                  ($c =~ m{return\s+30[12]\s+https://([\w.-]+)}g);
        unless ($t) {
            my $idx = "$CFG{sites_root}/$domain/web/index.html";
            my $ic = slurp($idx) // '';
            ($t) = $ic =~ m{url=https://([\w.-]+)};
        }
        $e{target} = $t if $t;
    }
    return \%e;
}

sub parse_domain_yml {
    my ($path) = @_;
    my $c = slurp($path) // return {};
    my %y;
    ($y{image})    = $c =~ /^\s*image:\s*(wordpress:\S+)/m;
    ($y{db_image}) = $c =~ /^\s*image:\s*(mariadb\S*|mysql\S*)/m;
    ($y{db_name})  = $c =~ /MYSQL_DATABASE:\s*(\S+)/;
    ($y{db_user})  = $c =~ /MYSQL_USER:\s*(\S+)/;
    ($y{password}) = $c =~ /MYSQL_PASSWORD:\s*(\S+)/;
    # Змінні оточення WordPress-сервісу, яких немає в схемі — щоб імпорт
    # не загубив ручні доповнення на кшталт PHP_DISPLAY_ERRORS.
    my %known = map { $_ => 1 } qw(WORDPRESS_DB_HOST WORDPRESS_DB_USER
                                   WORDPRESS_DB_PASSWORD WORDPRESS_DB_NAME
                                   MYSQL_DATABASE MYSQL_USER MYSQL_PASSWORD
                                   MYSQL_RANDOM_ROOT_PASSWORD);
    my @extra;
    while ($c =~ /^\s{6}([A-Z_][A-Z0-9_]*):\s*"?([^"\n]*?)"?\s*$/mg) {
        push @extra, "$1=$2" unless $known{$1};
    }
    $y{extra_env} = join(', ', @extra) if @extra;
    delete $y{$_} for grep { !defined $y{$_} } keys %y;
    return \%y;
}

sub cmd_import {
    my @args = @_;
    my $src = $ROOT;
    GetOptionsFromArray(\@args, 'from=s' => \$src) or die_err 'невідомий ключ';
    load_config();
    $src = abs_path($src) or die_err 'немає такого каталогу';

    my @confs = glob("$src/nginx/nginx-*.conf");
    die_err "у $src/nginx/ не знайдено жодного nginx-*.conf" unless @confs;

    my ($n, @notes, @reuse) = (0);
    for my $path (sort @confs) {
        my ($domain) = basename($path) =~ /^nginx-(.+)\.conf$/;
        next unless $domain && valid_domain($domain);

        my $e = parse_nginx_conf($path, $domain) or next;
        push @reuse, $domain if delete $e->{_reuseport};

        if (reg_load_one($domain)) { say_info "$domain — уже в реєстрі, пропущено"; next }

        my $yml = parse_domain_yml("$src/docker-compose.domains/$domain.yml");
        if ($e->{type} eq 'wordpress') {
            $e->{image}    = $yml->{image}    if $yml->{image};
            $e->{db_image} = $yml->{db_image} if $yml->{db_image} && $yml->{db_image} ne $CFG{db_image};
            $e->{db_name}  = $yml->{db_name}  || db_name_of($domain);
            $e->{db_user}  = $yml->{db_user}  || db_user_of($domain);
            # Успадкований пароль узято з працюючої БД, а не виведено з
            # ключа. Позначаємо як random, інакше `secrets restore` колись
            # підсуне БД пароль, якого вона не знає.
            $e->{password_mode} = 'random';
            $e->{extra_env} = $yml->{extra_env} if $yml->{extra_env};

            if ($yml->{password}) {
                unless (-f secret_path($domain)) {
                    make_path("$ROOT/secrets") unless -d "$ROOT/secrets";
                    chmod 0700, "$ROOT/secrets";
                    write_file(secret_path($domain), secret_body($domain, $yml->{password}),
                               force => 1, mode => 0600, quiet => 1);
                    say_ok "secrets/$domain.env — пароль перенесено з наявного yml (той самий, БД не чіпаємо)";
                }
            } else {
                push @notes, "$domain: не знайшов MYSQL_PASSWORD у docker-compose.domains/$domain.yml "
                           . '— пароль доведеться вписати в secrets/ вручну';
            }
            for my $k (qw(db_name db_user)) {
                my $derived = $k eq 'db_name' ? db_name_of($domain) : db_user_of($domain);
                push @notes, "$domain: $k='$e->{$k}' не збігається зі схемою іменування ('$derived') "
                           . '— лишено як є, БД перейменовувати не треба'
                    if $e->{$k} ne $derived;
            }
            my $expect = 'wordpress-' . sid_of($domain);
            push @notes, "$domain: nginx шле PHP на '$e->{php_service}', а не на '$expect' "
                       . '— перевірте, чи це не copy-paste на чужий сайт'
                if ($e->{php_service} // '') ne $expect;
        }
        push @notes, "$domain: тип redirect, але не знайшов домену призначення "
                   . '— впишіть target у domains/' . $domain . '.conf'
            if $e->{type} eq 'redirect' && !$e->{target};

        reg_save($e);
        say_ok "domains/$domain.conf — $e->{type}"
             . ($e->{target} ? " -> $e->{target}" : '')
             . ($e->{upstream} ? " -> $e->{upstream}" : '');
        $n++;
    }

    say_step "Імпортовано доменів: $n";
    if (@reuse) {
        say_info "reuseport на 443 стоїть у: @reuse";
        if (@reuse == 1 && lc($CFG{quic_reuseport_domain} // '') ne lc $reuse[0]) {
            say_warn "впишіть у dcp.conf:  quic_reuseport_domain = $reuse[0]";
        } elsif (@reuse > 1) {
            say_warn 'reuseport більш ніж в одному vhost — nginx впаде з "duplicate listen options"';
        }
    }
    say_warn $_ for @notes;
    print <<'TXT';

Нічого не змінено, крім реєстру domains/ і secrets/. Далі, не поспішаючи:
  dcpmgmt doctor          — звірити реєстр із тим, що реально на диску
  dcpmgmt render --diff   — побачити, чим згенероване відрізняється від наявного
  dcpmgmt apply           — застосувати (перед цим покаже, які контейнери смикне)
TXT
}

# ─────────────────────────── doctor ───────────────────────────

sub cmd_secrets {
    my @args = @_;
    my $sub  = shift @args // '';
    load_config();

    if ($sub eq 'show') {
        my $d = shift @args or die_err 'потрібен домен: dcpmgmt secrets show <domain>';
        my $e = reg_load_one($d) or die_err "домену $d немає в реєстрі";
        my %env = read_kv(secret_path($d));
        if ($env{mysql_password}) {
            print "$env{mysql_password}\n";
        }
        elsif (($e->{password_mode} // $CFG{password_mode}) eq 'derived') {
            say_warn "secrets/$d.env немає — показую виведений із ключа";
            print derived_password($d), "\n";
        }
        else {
            die_err "secrets/$d.env немає, а пароль домену випадковий — відновити нізвідки";
        }
    }
    elsif ($sub eq 'restore') {
        my ($created, @lost) = (0);
        for my $e (reg_all()) {
            next unless $e->{type} eq 'wordpress';
            my $d = $e->{domain};
            next if -f secret_path($d);
            if (($e->{password_mode} // $CFG{password_mode}) ne 'derived') {
                push @lost, $d;
                next;
            }
            make_path("$ROOT/secrets") unless -d "$ROOT/secrets";
            chmod 0700, "$ROOT/secrets";
            write_file(secret_path($d), secret_body($d, derived_password($d), 'derived'),
                       force => 1, mode => 0600, quiet => 1);
            say_ok "secrets/$d.env — відновлено з ключа";
            $created++;
        }
        say_ok "відновлено файлів: $created";
        if (@lost) {
            say_warn 'пароль випадковий, з ключа не виводиться: ' . join(', ', @lost);
            say_warn 'для цих доменів пароль доведеться змінити в самій БД:';
            say_warn "  docker exec -it db-<sid> mariadb -uroot -p  →  ALTER USER ... IDENTIFIED BY ...";
        }
    }
    elsif ($sub eq 'key') {
        my $path = master_key_path();
        master_key();                       # створить, якщо його ще немає
        printf "%s (%s)\n", $path, -f $path ? sprintf('%04o', (stat $path)[2] & 07777) : 'немає';
    }
    else {
        die_err 'dcpmgmt secrets show <domain> | restore | key';
    }
}

sub cmd_doctor {
    load_config();
    my @doms = reg_all();
    my ($errs, $warns) = (0, 0);
    my $bad  = sub { $errs++;  say_err @_ };
    my $soft = sub { $warns++; say_warn @_ };

    say_step 'Конфігурація';
    say_ok "проєкт compose: $CFG{project} (префікс імен volume'ів: ${\ $CFG{project}}_)";
    if (have_docker()) {
        my $out = capture('docker', 'ps', '-a', '--filter', 'name=^webserver$',
                          '--format', '{{.Label "com.docker.compose.project"}}');
        chomp $out;
        $bad->("контейнер webserver належить проєкту '$out', а dcp.conf каже '$CFG{project}'.\n"
             . "       Із таким розходженням compose створить НОВІ порожні volume'и замість наявних.\n"
             . "       Виправте project у dcp.conf на '$out'.")
            if $out && $out ne $CFG{project};
    }

    say_step 'Домени';
    my (%php_seen, %name_owner);
    for my $e (@doms) {
        my $d = $e->{domain};
        my @p;
        push @p, 'немає nginx-конфіга'         unless -f nginx_conf_path($d);
        push @p, "немає каталогу $CFG{sites_root}/$d/web" unless -d "$CFG{sites_root}/$d/web";
        push @p, 'немає сертифіката'           unless cert_live($d);

        # Конфіг, у якому server_name не збігається з доменом — типовий
        # наслідок copy-paste сусіднього файла. Домен просто не потрапляє
        # в цей server-блок: запити йдуть у vhost за замовчуванням, а
        # acme-challenge віддає 404, тож сертифікат мовчки не подовжується.
        if (-f nginx_conf_path($d)) {
            my @names = nginx_server_names(nginx_conf_path($d));
            push @p, "server_name у конфізі — '" . join(' ', @names) . "', а не $d. "
                   . 'Домен не обслуговується цим блоком: запити йдуть у vhost за '
                   . 'замовчуванням, acme-challenge віддає 404 і сертифікат не '
                   . "подовжується. Полагодити: dcpmgmt render --force $d"
                if @names && !grep { $_ eq $d } @names;
            for my $name (@names) {
                $soft->("server_name '$name' оголошено і в nginx-$d.conf, і в "
                      . "nginx-$name_owner{$name}.conf — nginx візьме перший за абеткою")
                    if $name_owner{$name} && $name_owner{$name} ne $d;
                $name_owner{$name} //= $d;
            }
        }
        my $expired  = cert_live($d) && cert_expires_within($d, 0);
        my $expiring = cert_live($d) && !$expired && cert_expires_within($d, 14 * 24 * 3600);
        # Протермінований сертифікат — це зламаний сайт просто зараз:
        # браузер показує попередження замість сторінки.
        push @p, 'сертифікат ПРОТЕРМІНОВАНО (' . (cert_expiry($d) // '') . ')' if $expired;
        if ($e->{type} eq 'wordpress') {
            push @p, "немає каталогу БД $CFG{sites_root}/$d/db" unless -d "$CFG{sites_root}/$d/db";
            push @p, 'немає secrets/' . "$d.env" unless -f secret_path($d);
            push @p, 'порожній web/ — WordPress не розгорнувся'
                if -d "$CFG{sites_root}/$d/web" && !-e "$CFG{sites_root}/$d/web/index.php";
            if (my $mode = (stat secret_path($d))[2]) {
                $soft->("secrets/$d.env має права " . sprintf('%04o', $mode & 07777) . ', очікується 0600')
                    if ($mode & 07777) != 0600;
            }
            $bad->("$d: образ $e->{image} — не fpm-варіант. nginx ходить у "
                 . "WordPress через fastcgi_pass :9000, а апачевий образ слухає "
                 . "HTTP на 80: домен віддасть 502. Потрібен, наприклад, "
                 . "wordpress:php8.4-fpm")
                if image_not_fpm($e->{image} // '');

            # Тег образу і встановлена версія розходяться самі собою: WordPress
            # оновлюється через власний апдейтер, а тег лишається старим.
            # Наявним файлам це не шкодить (entrypoint не чіпає непорожній
            # каталог), але порожній каталог отримає версію з тега.
            my $yml = slurp(domain_yml_path($d)) // '';
            for my $ini (sort glob("$CFG{sites_root}/$d/php/*.ini")) {
                next if index($yml, $ini) >= 0;
                $soft->("$d: " . basename($ini) . " лежить у php/, але не змонтований — "
                      . "PHP його не бачить. Полагодити: dcpmgmt render --force $d && dcpmgmt apply");
            }

            my $installed = wp_installed_version($d);
            my ($tagged) = ($e->{image} // '') =~ /^wordpress:(\d+(?:\.\d+)*)/;
            $soft->("$d: у web/ стоїть WordPress $installed, а образ у реєстрі — "
                  . "$e->{image}. Робочому сайту це не шкодить, але після "
                  . 'відновлення порожнього web/ розгорнеться версія з тега')
                if $installed && $tagged && index($installed, $tagged) != 0;

            my $php = $e->{php_service} // '';
            $soft->("$d: PHP іде на '$php', який уже обслуговує $php_seen{$php} — copy-paste на чужий сайт?")
                if $php && $php_seen{$php};
            $php_seen{$php} = $d if $php;
        }
        push @p, 'тип redirect без target'     if $e->{type} eq 'redirect' && !$e->{target};
        $soft->("$d: docker-compose.domains/$d.yml ще з CHANGE-ME — опишіть сервіс "
              . 'застосунку, інакше домен лишається поза стеком')
            if $e->{type} eq 'proxy' && -f domain_yml_path($d) && !domain_yml_ready($d);

        # Let's Encrypt подовжує за 30 днів до кінця; якщо лишилось менше
        # двох тижнів, автоматика вже мала спрацювати і не спрацювала.
        $soft->("$d: сертифікат спливає менш ніж за 14 днів (" . (cert_expiry($d) // '')
              . ') — автоматичне подовження не спрацювало, розберіться зараз')
            if $expiring;

        if (@p) { $bad->("$d: $_") for @p }
        else    { printf "  %s %-34s %s\n", c('1;32', '  ok  '), $d, cert_expiry($d) // '' }
    }

    say_step 'Подовження сертифікатів';
    # Стан спільного certbot. Невдалий прогін не видно ніде, крім його
    # логу: контейнер лишається «Up», просто нічого не робить до
    # наступного циклу — рівно та тиша, через яку сертифікати й
    # протермінувалися.
    if (have_docker()) {
        if (container_running('certbot')) {
            my $log = capture('docker', 'logs', '--tail', '50', 'certbot');
            my @failures = grep { /Another instance of Certbot|Failed to renew/i }
                           split /\n/, $log;
            if (@failures) {
                $soft->('останній прогін спільного certbot завершився помилкою:');
                $soft->("    $_") for @failures;
                $soft->('перезапустити: docker compose restart certbot');
            } else {
                say_ok 'спільний certbot працює, помилок у свіжому логу немає';
            }
        } else {
            $bad->('спільний контейнер certbot не працює — сертифікати не '
                 . 'подовжуватимуться. Підняти: dcpmgmt apply');
        }
    }
    # Спільний certbot виконує `certbot renew` для всіх сертифікатів одразу,
    # а шлях до webroot кожен сертифікат пам'ятає у своєму renewal-конфізі,
    # записаному при первинній видачі. Якщо шлях не збігається з тим, що ми
    # монтуємо, подовження тихо провалиться — і виявиться це за 90 днів.
    for my $e (@doms) {
        my $d  = $e->{domain};
        my $rc = "$CFG{letsencrypt_dir}/etc/renewal/$d.conf";
        unless (-e $rc) {
            $soft->("$d: немає $rc — сертифікат не подовжуватиметься автоматично")
                if cert_live($d);
            next;
        }
        my $c = slurp($rc) // next;
        my ($auth) = $c =~ /^authenticator\s*=\s*(\S+)/m;
        # certbot renew повторює той спосіб перевірки, яким сертифікат
        # видали. `manual` означає, що challenge колись проходили руками,
        # і без --manual-auth-hook renew його просто не виконає: сертифікат
        # тихо доживе до кінця терміну.
        $bad->("$d: у renewal-конфізі authenticator=$auth, а не webroot. "
             . "Автоматичне подовження НЕ працює.\n"
             . "       Полагодити — перевидати через webroot, це перепише конфіг:\n"
             . "       dcpmgmt cert issue $d --force")
            if $auth && $auth ne 'webroot';
        my @paths = $c =~ /^webroot_path\s*=\s*(.+)$/m ? split(/\s*,\s*/, $1) : ();
        push @paths, ($c =~ /^\Q$d\E\s*=\s*(\S+)/m ? $1 : ());
        my $want = "/var/www/html/$d";
        next unless @paths;
        unless (grep { $_ eq $want } @paths) {
            $bad->("$d: у renewal-конфізі webroot_path='" . join(',', @paths) . "', "
                 . "а спільний certbot монтує webroot як '$want'.\n"
                 . "       Подовження провалиться. Полагодити одноразово:\n"
                 . "       sed -i 's,$paths[0],$want,g' $rc");
        }
    }

    # Успадковані per-домен certbot-контейнери конкурують зі спільним за
    # lock у /etc/letsencrypt і, на додачу, не мають політики перезапуску:
    # один раз вийшли з помилкою — і більше не піднялися, а подовження
    # тихо перестало відбуватися.
    my @legacy_certbot = grep { (slurp(domain_yml_path($_)) // '') =~ /^\s{2}certbot-/m }
                         map  { $_->{domain} } @doms;
    if (@legacy_certbot) {
        $soft->('у файлах доменів лишилися власні certbot-сервіси: '
              . join(', ', @legacy_certbot));
        $soft->('вони роблять те саме, що спільний certbot, конкуруючи з ним за lock, '
              . 'і не мають restart: — вийшовши з помилкою, більше не піднімуться.');
        $soft->('прибрати: dcpmgmt render --force <домен> && dcpmgmt apply '
              . '(для proxy-домену — видалити блок вручну, файл ваш)');
    }

    say_step 'nginx';
    # nginx_conf_dir монтується в /etc/nginx/conf.d цілком, тож усе, що
    # там лежить, nginx вантажить як свою конфігурацію — нарівні з
    # vhost-ами, які цей стек монтує поштучно. Успадкований монолітний
    # конфіг від попередньої інсталяції кладе таким чином увесь webserver,
    # причому в помилці згадується чужий upstream, а не файл-винуватець.
    my %ours = map { $_ => 1 } map { nginx_conf_path($_->{domain}) } @doms;
    my @stray = grep { -f $_ && !$ours{$_} } glob("$CFG{nginx_conf_dir}/*.conf");
    if (@stray) {
        $soft->("$CFG{nginx_conf_dir} містить конфіги, які nginx вантажить разом зі "
              . 'згенерованими: ' . join(', ', map { basename($_) } @stray));
        $soft->('якщо це спадок попередньої інсталяції — приберіть каталог убік; '
              . 'vhost-и цього стека туди не кладуться, вони монтуються з nginx/');
    }

    my @reuse = grep { (nginx_uncommented($_) // '') =~ /reuseport/ } glob("$ROOT/nginx/nginx-*.conf");
    if (@reuse > 1) {
        $bad->('reuseport на 443 більш ніж в одному vhost — nginx впаде з "duplicate listen options": '
             . join(', ', map { basename($_) } @reuse));
    } elsif (!@reuse && grep { $_->{http3} eq 'on' } @doms) {
        $soft->('жоден vhost не має reuseport на 443 — HTTP/3 працюватиме, але без розподілу '
              . 'QUIC-з\'єднань між воркерами (dcp.conf: quic_reuseport_domain)');
    }

    # HTTP/3 не має заголовка Host — лише псевдозаголовок :authority, тож
    # $http_host (звідки fastcgi бере HTTP_HOST) порожній, і WordPress
    # віддає canonical redirect на "https:///" — у Chrome це
    # ERR_INVALID_REDIRECT. Конфіги, згенеровані до 1.10.0, рядка не мають.
    for my $e (grep { $_->{type} eq 'wordpress' && $_->{http3} eq 'on' } @doms) {
        my $body = nginx_uncommented(nginx_conf_path($e->{domain})) // next;
        next if $body =~ /fastcgi_param\s+HTTP_HOST\s+\$host\s*;/;
        $bad->("$e->{domain}: http3 = on, але у vhost немає "
             . "'fastcgi_param HTTP_HOST \$host;' — по HTTP/3 WordPress віддасть "
             . "редірект на 'https:///' (у Chrome ERR_INVALID_REDIRECT).\n"
             . "       Полагодити: dcpmgmt render --force $e->{domain} && dcpmgmt apply");
    }

    say_step 'Паролі';
    my $key_path = master_key_path();
    if (-f $key_path) {
        my $key_mode = sprintf('%04o', (stat $key_path)[2] & 07777);
        $soft->("майстер-ключ $key_path має права $key_mode, очікується 0400")
            if $key_mode ne '0400';
        say_ok "майстер-ключ $key_path ($key_mode)";
    } else {
        say_ok "майстер-ключа ще немає — з'явиться при першому derived-паролі";
    }
    for my $e (@doms) {
        next unless $e->{type} eq 'wordpress';
        next unless ($e->{password_mode} // $CFG{password_mode}) eq 'derived';
        my $d = $e->{domain};
        next unless -f secret_path($d) && -f $key_path;
        my %env = read_kv(secret_path($d));
        next unless $env{mysql_password};
        # Розходження означає або підмінений майстер-ключ, або ручну зміну
        # пароля. Друге законно, перше зробить `secrets restore` шкідливим.
        $soft->("$d: пароль у secrets/ не збігається з виведеним із ключа. "
              . 'Змінювали вручну — гаразд; якщо ні, ключ не той, і '
              . '`secrets restore` підсуне БД чужий пароль')
            if $env{mysql_password} ne derived_password($d);
    }

    say_step 'QUIC';
    if (quic_bpf_enabled()) {
        $bad->('quic_bpf = on, але nginx/nginx.conf не згенеровано — директива '
             . 'головного контексту нікуди не потрапила. Виконайте: dcpmgmt render')
            unless -f main_nginx_conf_path();
        $soft->('quic_bpf = on при worker_processes = 1 нічого не дає: воркер один, '
              . 'розподіляти QUIC-пакети між ними нема потреби')
            if $CFG{worker_processes} eq '1';
        $soft->('quic_bpf = on, але жоден vhost не має reuseport — без нього eBPF-'
              . 'маршрутизація не застосовується (dcp.conf: quic_reuseport_domain)')
            unless $CFG{quic_reuseport_domain};
    }
    elsif (-f main_nginx_conf_path() && (nginx_uncommented(main_nginx_conf_path()) // '') =~ /quic_bpf\s+on/) {
        $soft->('nginx/nginx.conf вмикає quic_bpf, а dcp.conf каже off — привілеї '
              . 'для bpf() у compose не додаються, nginx може не стартувати');
    }

    # Каталог інсталяції часто беруть під git заради відкату — і разом зі
    # станом туди легко заїжджають паролі. Найчастіше не самі secrets/, а
    # похідні: config.yaml від `docker compose config` містить усі паролі
    # в розкритому вигляді, конфіги проксійованих застосунків — свої.
    if (-d "$ROOT/.git") {
        say_step 'Секрети в git';
        my @tracked = split /\n/, capture('git', '-C', $ROOT, 'ls-files');
        my @by_name = grep { m{^secrets/} || $_ eq 'dcp.conf' || $_ eq 'config.yaml'
                             || /htpasswd/i || /\.(key|pem)$/ } @tracked;
        # Шукаємо присвоєння з правдоподібним значенням, а не саму згадку
        # назви: рядки на кшталт awk '/"MYSQL_PASSWORD=/ { … }' у скриптах
        # розбору — це шаблон пошуку, а не пароль. Тому після роздільника
        # вимагається щонайменше вісім символів, з яких складаються паролі.
        my $secret_pattern =
            q{(MYSQL_PASSWORD|WORDPRESS_DB_PASSWORD)[:=] *["']?[A-Za-z0-9+/=_.-]{8,}}
          . q{|<password>[A-Za-z0-9+/=_.-]{8,}};
        # Сам інструмент і шаблони згадують назви змінних без значень.
        my @by_content = split /\n/, capture('git', '-C', $ROOT, 'grep', '-I', '-l', '-E',
            $secret_pattern, '--', ':!dcpmgmt', ':!templates', ':!docs');
        my %risky = map { $_ => 1 } @by_name, @by_content;
        if (%risky) {
            $soft->('у git відстежуються файли з паролями: ' . join(', ', sort keys %risky));
            $soft->('прибрати з індексу, лишивши на диску:');
            $soft->('    git rm --cached ' . join(' ', sort keys %risky));
            $soft->('потім дописати їх у .gitignore. Якщо репозиторій уже кудись пушили — '
                  . 'паролі треба вважати скомпрометованими й міняти.');
        } else {
            say_ok 'серед відстежуваних git файлів паролів не видно';
        }
    }

    say_step 'Файли без пари';
    my %known = map { $_->{domain} => 1 } @doms;
    for my $f (glob("$ROOT/nginx/nginx-*.conf")) {
        my ($d) = basename($f) =~ /^nginx-(.+)\.conf$/;
        next unless $d && !$known{$d};
        if (valid_domain($d)) {
            $soft->("nginx/nginx-$d.conf є, а домену $d немає в реєстрі (dcpmgmt import?)");
        } else {
            $soft->("nginx/nginx-$d.conf — не конфіг домену, нікуди не монтується і "
                  . 'ніколи не діяв: conf.d інклюдиться всередині http{}, а директиви '
                  . 'головного контексту там не дозволені. Якщо це був quic_bpf — '
                  . 'вмикайте його через dcp.conf (quic_bpf = on), а файл видаліть');
        }
    }
    for my $f (glob("$ROOT/docker-compose.domains/*.yml")) {
        my $d = basename($f, '.yml');
        $soft->("docker-compose.domains/$d.yml є, а домену $d немає в реєстрі") unless $known{$d};
    }

    if (have_docker()) {
        say_step 'docker compose config';
        chdir $ROOT;
        if (run('docker', 'compose', 'config', '-q')) { say_ok 'конфігурація коректна' }
        else { $bad->('docker compose config не проходить — стек у такому стані не підніметься') }
    }

    print "\n";
    if ($errs) { say_warn c('1;31', "помилок: $errs, попереджень: $warns"); exit 1 }
    say_ok "помилок немає" . ($warns ? ", попереджень: $warns" : '');
}

# ─────────────────────────── main ───────────────────────────

sub usage {
    print <<'TXT';
dcpmgmt — керування доменами docker web-стека (nginx + WordPress/redirect/proxy)

  dcpmgmt init                          створити структуру проєкту з нуля
  dcpmgmt import [--from DIR]           зібрати реєстр із наявної інсталяції

  dcpmgmt add wordpress <domain> [--image IMG] [--no-http3] [--no-cert]
  dcpmgmt add redirect  <domain> --to <target> [--no-cert]
  dcpmgmt add proxy     <domain> --upstream <host:port> [--no-cert]
  dcpmgmt remove <domain> [--purge]     --purge = разом із даними й сертифікатом

  dcpmgmt list [--type T] [--names]     що є в реєстрі (--names: для скриптів)
  dcpmgmt doctor                        перевірити узгодженість усього
  dcpmgmt render [--diff] [--force] [<domain>...]   перегенерувати файли
  dcpmgmt apply [--force]               застосувати до працюючого стека

  dcpmgmt up      [<domain>]            підняти стек або контейнери домену
  dcpmgmt down    [<domain>]            зупинити те саме
  dcpmgmt restart [<domain>]            перезапустити те саме

  dcpmgmt cert issue|renew|list [<domain>] [--staging] [--force] [--dry-run]
  dcpmgmt secrets show <domain> | restore | key

Глобальні ключі:  --yes (не питати підтверджень)

Джерело істини — domains/*.conf і dcp.conf; усе інше генерується.
Подробиці: README.md
TXT
}

sub main {
    my @args = @_;
    @args = grep { $_ ne '--yes' or !($YES = 1) } @args;
    my $cmd = shift(@args) // '';

    if    ($cmd eq 'init')    { cmd_init(@args) }
    elsif ($cmd eq 'import')  { cmd_import(@args) }
    elsif ($cmd eq 'add')     { cmd_add(@args) }
    elsif ($cmd eq 'remove'
        || $cmd eq 'rm')      { cmd_remove(@args) }
    elsif ($cmd eq 'list'
        || $cmd eq 'ls')      { cmd_list(@args) }
    elsif ($cmd eq 'render')  { cmd_render(@args) }
    elsif ($cmd eq 'apply')   { cmd_apply(@args) }
    elsif ($cmd eq 'up'
        || $cmd eq 'down'
        || $cmd eq 'restart') { cmd_lifecycle($cmd, @args) }
    elsif ($cmd eq 'cert')    { cmd_cert(@args) }
    elsif ($cmd eq 'secrets') { cmd_secrets(@args) }
    elsif ($cmd eq 'doctor')  { cmd_doctor(@args) }
    elsif ($cmd eq 'version') { print "dcpmgmt $VERSION\n" }
    elsif ($cmd eq 'help' || $cmd eq '--help' || $cmd eq '-h' || $cmd eq '') { usage() }
    else { usage(); die_err "невідома команда '$cmd'" }
}

main(@ARGV);
