#!/usr/bin/perl
#
# dcpmgmt — керування доменами мультидоменного docker-стека
#           (один nginx-фронтенд + per-домен WordPress / redirect / proxy).
#
# Джерело істини — реєстр domains/*.conf і dcp.conf. Усе інше
# (docker-compose.yml, docker-compose.main.yml, nginx/*.conf,
# docker-compose.domains/*.yml) генерується з нього за шаблонами
# з templates/. Ручні правки в згенерованому не зникають мовчки:
# `render` без --force не перезаписує наявні файли, а `render --diff`
# показує розбіжність.
#
# Документація: README.md
#
# SPDX-License-Identifier: GPL-2.0-only

use strict;
use warnings;
use utf8;                       # у вихідному коді є кирилиця
use File::Basename qw(basename dirname);
use File::Path qw(make_path remove_tree);
use File::Temp qw(tempdir);
use Cwd qw(abs_path);
use Getopt::Long qw(GetOptionsFromArray);

our $VERSION = '1.0.0';

my $ROOT = dirname(abs_path($0));

binmode STDOUT, ':encoding(UTF-8)';
binmode STDERR, ':encoding(UTF-8)';

$| = 1;   # без буферизації: інакше stdout і stderr плутаються місцями

# ─────────────────────────── вивід ───────────────────────────

my $NOCOLOR = (!-t STDOUT) || $ENV{NO_COLOR};
sub c { my ($code, $s) = @_; return $NOCOLOR ? $s : "\e[${code}m${s}\e[0m"; }
sub say_ok   { print c('1;32', '  ok  '), " @_\n"; }
sub say_info { print c('1;34', ' info '), " @_\n"; }
sub say_warn { print c('1;33', ' увага'), " @_\n"; }
sub say_step { print "\n", c('1;37', "== @_"), "\n"; }
sub die_err  { print STDERR c('1;31', ' збій '), " @_\n"; exit 1; }
sub say_err  { print c('1;31', 'помилка'), " @_\n"; }

my $YES = 0;
sub confirm {
    my ($q) = @_;
    return 1 if $YES;
    print c('1;33', ' ? '), " $q [так/ні]: ";
    my $a = <STDIN>;
    return 0 unless defined $a;
    chomp $a;
    return $a =~ /^(так|yes|y)$/i;
}

# ─────────────────────────── конфіг ───────────────────────────

my %CFG = (
    project         => 'docker-compose-project',
    sites_root      => '/var/sites',
    nginx_conf_dir  => '/var/sites/nginx-conf',
    letsencrypt_dir => '/var/sites/letsencrypt',
    certbot_email   => '',
    wordpress_image => 'wordpress:6.8.3-php8.4-fpm',
    db_image        => 'mariadb:latest',
    nginx_image     => 'nginx:latest',
    certbot_image   => 'certbot/certbot',
    tz              => 'Europe/Kiev',
    quic_reuseport_domain => '',
    reload_interval => '6h',
    renew_interval  => '12h',
);

sub read_kv {
    my ($path) = @_;
    my %h;
    open my $fh, '<:encoding(UTF-8)', $path or return;
    while (my $l = <$fh>) {
        chomp $l;
        $l =~ s/^\s+|\s+$//g;
        next if $l eq '' || $l =~ /^#/;
        my ($k, $v) = $l =~ /^([A-Za-z0-9_]+)\s*=\s*(.*)$/ or next;
        $v =~ s/\s+$//;
        $h{lc $k} = $v;
    }
    close $fh;
    return %h;
}

sub load_config {
    my $path = "$ROOT/dcp.conf";
    unless (-f $path) {
        die_err "немає $path. Скопіюйте dcp.conf.example -> dcp.conf і виправте,\n"
              . "       або запустіть: dcpmgmt init";
    }
    my %h = read_kv($path);
    $CFG{$_} = $h{$_} for grep { exists $CFG{$_} } keys %h;
    for my $unknown (grep { !exists $CFG{$_} } keys %h) {
        say_warn "dcp.conf: невідомий ключ '$unknown' — проігноровано";
    }
    die_err "dcp.conf: не заповнено certbot_email" unless $CFG{certbot_email};
}

# ─────────────────────── імена, похідні від домену ───────────────────────
#
# Усі ідентифікатори БД виводяться з імені домену детерміновано —
# нічого не питаємо в користувача і нічого не вигадуємо двічі.
#   www.ukr-com.net -> sid  wwwukr-comnet   (крапки геть, дефіси лишаються)
#                      db   wwwukr-comnet
#                      user uwwwukr-comnet
#                      host db-wwwukr-comnet
# Саме так названі наявні продакшн-контейнери — сумісність навмисна.

sub sid_of {
    my ($domain) = @_;
    my $s = lc $domain;
    $s =~ s/\.//g;
    return $s;
}

# Суфікс для обрізаних імен: потрібен лише для унікальності, не для
# криптографії. Digest::MD5 є в core perl, але якщо збірка без нього —
# контрольної суми рядка вистачить для тієї ж мети.
sub md5_hex_of {
    my ($value) = @_;
    eval { require Digest::MD5; 1 }
        or return substr(sprintf('%08x', unpack('%32C*', $value)), 0, 8);
    return substr(Digest::MD5::md5_hex($value), 0, 8);
}

# Ліміт імені бази — 64 символи, імені користувача — 32 (MySQL; MariaDB
# щедріша, але тримаємось меншого). Довші домени обрізаємо й доліплюємо
# суфікс, щоб два схожі домени не отримали однакове ім'я.
sub db_name_of {
    my ($domain) = @_;
    my $name = sid_of($domain);
    return length($name) <= 64 ? $name : substr($name, 0, 55) . '_' . md5_hex_of($domain);
}

sub db_user_of {
    my ($domain) = @_;
    my $user = 'u' . sid_of($domain);
    return length($user) <= 32 ? $user : substr($user, 0, 23) . '_' . md5_hex_of($domain);
}

sub random_password {
    my $length   = 48;
    my @alphabet = ('A'..'Z', 'a'..'z', 0..9);   # 62 символи

    # Байти, що не діляться націло на розмір алфавіту, відкидаємо, а не
    # беремо за модулем: 256 % 62 = 8, тож перші вісім символів алфавіту
    # інакше випадали б частіше за решту.
    my $limit = int(256 / @alphabet) * @alphabet;

    open my $fh, '<:raw', '/dev/urandom' or die_err 'немає /dev/urandom';
    my $password = '';
    while (length($password) < $length) {
        read $fh, my $buf, $length or die_err 'не читається /dev/urandom';
        $password .= $alphabet[$_ % @alphabet] for grep { $_ < $limit } unpack 'C*', $buf;
    }
    close $fh;
    return substr($password, 0, $length);
}

# Тільки нижній регістр і мінімум одна крапка. Кирилиця не приймається
# свідомо: ім'я домену стає іменем каталогу, контейнера й бази, тож
# інтернаціоналізовані домени подаються в punycode (xn--...), як вони й
# записані в наявному стеку.
sub valid_domain {
    my ($domain) = @_;
    return 0 if length($domain) > 253;
    return $domain =~ /^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$/;
}

# ─────────────────────────── реєстр ───────────────────────────

sub reg_dir  { "$ROOT/domains" }
sub reg_path { my ($d) = @_; reg_dir() . "/$d.conf" }

sub reg_load_one {
    my ($d) = @_;
    my %h = read_kv(reg_path($d));
    return undef unless %h;
    $h{domain} = $d;
    $h{type}     //= 'redirect';
    $h{http3}    //= 'on';
    $h{enabled}  //= 'yes';
    return \%h;
}

sub reg_all {
    my @out;
    for my $f (sort glob(reg_dir() . '/*.conf')) {
        my $d = basename($f, '.conf');
        my $e = reg_load_one($d) or next;
        push @out, $e;
    }
    return @out;
}

sub reg_enabled { grep { $_->{enabled} eq 'yes' } reg_all() }

sub reg_save {
    my ($e) = @_;
    my $d = $e->{domain};
    make_path(reg_dir()) unless -d reg_dir();
    my @order = qw(type domain target upstream app_service image db_image
                   db_name db_user php_service http3 enabled note);
    my $out = "# Реєстр домену $d. Джерело істини для dcpmgmt render.\n"
            . "# Змінили щось руками — виконайте: dcpmgmt render --diff\n";
    for my $k (@order) {
        next unless defined $e->{$k} && $e->{$k} ne '';
        $out .= sprintf("%-11s = %s\n", $k, $e->{$k});
    }
    write_file(reg_path($d), $out, force => 1, quiet => 1);
    return 1;
}

# ─────────────────────────── файли ───────────────────────────

# Вміст nginx-конфіга без коментарів. Закоментований `# listen 443 quic
# reuseport;` — це не конфігурація, і шукати в ньому directives не можна.
sub nginx_uncommented {
    my ($path) = @_;
    my $c = slurp($path) // return undef;
    $c =~ s/(^|\s)#[^\n]*//g;
    return $c;
}

sub slurp {
    my ($p) = @_;
    open my $fh, '<:encoding(UTF-8)', $p or return undef;
    local $/;
    my $c = <$fh>;
    close $fh;
    return $c;
}

# write_file($path, $content, force => 0|1, diff => 0|1, mode => 0644, quiet => 0|1)
#   Наявний файл із іншим вмістом без force НЕ перезаписується — це головна
#   гарантія проти «скрипт затер мої ручні правки на проді».
sub write_file {
    my ($path, $content, %o) = @_;
    my $rel = $path;
    $rel =~ s/^\Q$ROOT\E\///;
    my $old = slurp($path);

    if (defined $old && $old eq $content) {
        say_ok "$rel — без змін" unless $o{quiet};
        return 'unchanged';
    }
    if (defined $old && !$o{force}) {
        if ($o{diff}) {
            say_info "$rel — відрізняється від згенерованого:";
            show_diff($path, $content);
        } elsif ($o{owned_by_admin}) {
            say_info "$rel — ваш файл, dcpmgmt його не чіпає (свіжий каркас: видаліть файл і повторіть render)";
        } else {
            say_warn "$rel — існує і відрізняється, залишено як є (--force перезапише, --diff покаже різницю)";
        }
        return 'skipped';
    }

    make_path(dirname($path)) unless -d dirname($path);
    if (defined $old) {
        my $bak = "$path.bak";
        if (open my $bh, '>:encoding(UTF-8)', $bak) { print $bh $old; close $bh; chmod 0600, $bak; }
    }
    open my $fh, '>:encoding(UTF-8)', $path or die_err "не можу писати $path: $!";
    # Права виставляються до запису вмісту: інакше файл із паролем устигає
    # полежати з дефолтними 0644 рівно стільки, скільки триває print.
    chmod($o{mode}, $path) if $o{mode};
    print $fh $content;
    close $fh;
    say_ok(defined $old ? "$rel — оновлено" : "$rel — створено") unless $o{quiet};
    return defined $old ? 'updated' : 'created';
}

sub show_diff {
    my ($path, $new) = @_;
    my $dir = tempdir(CLEANUP => 1);
    open my $fh, '>:encoding(UTF-8)', "$dir/new" or return;
    print $fh $new;
    close $fh;
    system('diff', '-u', '--label', $path, '--label', "$path (згенероване)", $path, "$dir/new");
}

# ─────────────────────────── шаблони ───────────────────────────

sub render_template {
    my ($name, %vars) = @_;
    my $path = "$ROOT/templates/$name";
    my $template = slurp($path) or die_err "немає шаблону $path";
    my %missing;
    $template =~ s/\{\{(\w+)\}\}/
        defined $vars{$1} ? $vars{$1} : do { $missing{$1} = 1; "{{$1}}" }
    /ge;
    # Незаповнений плейсхолдер лишається в тексті й дійде до nginx або
    # compose як сміття. Не вбиваємо генерацію, але кажемо вголос, бо
    # інакше причину шукатимуть у повідомленні nginx, а не в шаблоні.
    say_warn "шаблон $name: не заповнено " . join(', ', map { "{{$_}}" } sort keys %missing)
        if %missing;
    return $template;
}

# ─────────────────────────── docker ───────────────────────────

sub run {
    my (@cmd) = @_;
    say_info c('0;36', join ' ', @cmd);
    my $rc = system(@cmd);
    return $rc == 0;
}

sub run_or_die {
    my (@cmd) = @_;
    run(@cmd) or die_err "команда завершилась помилкою: @cmd";
}

# Вивід команди без запуску шелла (аргументи можуть містити що завгодно).
# stderr глушиться навмисно: docker пише туди попередження, які інакше
# потраплять у розбір як дані.
sub capture {
    my (@cmd) = @_;
    my $pid = open(my $fh, '-|');
    die_err "fork: $!" unless defined $pid;
    if (!$pid) { open STDERR, '>', '/dev/null'; exec @cmd; exit 127; }
    local $/;
    my $out = <$fh>;
    close $fh;
    return defined $out ? $out : '';
}

sub have_docker { return system('docker version >/dev/null 2>&1') == 0 }

sub compose { my (@a) = @_; chdir $ROOT; return run('docker', 'compose', @a) }

sub container_running {
    my ($name) = @_;
    my $out = capture('docker', 'ps', '--format', '{{.Names}}');
    return grep { $_ eq $name } split /\n/, $out;
}

sub nginx_test_reload {
    unless (container_running('webserver')) {
        say_warn 'контейнер webserver не запущено — nginx -t пропущено';
        return 0;
    }
    unless (run('docker', 'exec', 'webserver', 'nginx', '-t')) {
        die_err "nginx -t не пройшов. Конфігурацію НЕ перезавантажено, працюючий nginx\n"
              . "       далі крутиться зі старою конфігурацією в пам'яті — сайти живі.\n"
              . "       Полагодьте конфіг і повторіть: dcpmgmt apply";
    }
    run_or_die('docker', 'exec', 'webserver', 'nginx', '-s', 'reload');
    say_ok 'nginx перезавантажено';
    return 1;
}

sub cert_dir  { my ($d) = @_; "$CFG{letsencrypt_dir}/etc/live/$d" }
sub cert_live { my ($d) = @_; -e cert_dir($d) . '/fullchain.pem' }

# ─────────────────────────── секрети ───────────────────────────

sub secret_path { my ($d) = @_; "$ROOT/secrets/$d.env" }

sub secret_ensure {
    my ($e) = @_;
    my $d    = $e->{domain};
    my $path = secret_path($d);
    return 0 if -f $path;
    my $pass = random_password();
    make_path("$ROOT/secrets") unless -d "$ROOT/secrets";
    chmod 0700, "$ROOT/secrets";
    write_file($path, secret_body($d, $pass), force => 1, mode => 0600, quiet => 1);
    say_ok "secrets/$d.env — створено (пароль згенеровано, 48 символів)";
    return 1;
}

sub secret_body {
    my ($d, $pass) = @_;
    return "# Пароль БД для $d. Згенеровано dcpmgmt, у git не потрапляє.\n"
         . "# Підключається через env_file у docker-compose.domains/$d.yml.\n"
         . "# Зміна пароля тут НЕ змінює його в уже ініціалізованій БД —\n"
         . "# спершу ALTER USER у самій MariaDB, потім правка цього файла.\n"
         . "MYSQL_PASSWORD=$pass\n"
         . "WORDPRESS_DB_PASSWORD=$pass\n";
}

# ─────────────────────── генерація nginx-конфігів ───────────────────────

sub listen443_block {
    my ($e) = @_;
    my $d = $e->{domain};
    my @l;
    my $h3 = ($e->{http3} // 'on') eq 'on';
    if ($h3) {
        # reuseport на спільному порті 443 має стояти РІВНО в одному vhost
        # на весь стек, інакше nginx падає з "duplicate listen options",
        # показуючи при цьому на чужий файл (той, що вантажиться пізніше
        # за абеткою), а не на винуватця.
        my $ru = (lc($CFG{quic_reuseport_domain} // '') eq lc $d) ? ' reuseport' : '';
        push @l, "    listen 443 quic$ru;";
    }
    push @l, '    listen 443 ssl;';
    push @l, '    listen [::]:443 ssl;';
    push @l, '    http2 on;';
    if ($h3) {
        push @l, '    http3 on;';
        push @l, '    quic_gso on;';
        push @l, '    quic_retry on;';
    }
    return join "\n", @l;
}

sub alt_svc_line {
    my ($e) = @_;
    return '' unless ($e->{http3} // 'on') eq 'on';
    return qq{    add_header Alt-Svc 'h3=":443"; h3-29=":443"; ma=86400';\n};
}

sub nginx_conf_path { my ($d) = @_; "$ROOT/nginx/nginx-$d.conf" }

sub nginx_conf_body {
    my ($e) = @_;
    my $d    = $e->{domain};
    my %v = (
        domain     => $d,
        webroot    => "/var/www/html/$d",
        listen443  => listen443_block($e),
        alt_svc    => alt_svc_line($e),
        target     => $e->{target}      // '',
        upstream   => $e->{upstream}    // '',
        php_service=> $e->{php_service} // ('wordpress-' . sid_of($d)),
    );
    # Поки сертифіката фізично немає — віддаємо :80-заглушку. ssl_certificate
    # на неіснуючий файл валить увесь nginx, а не тільки цей сайт, тож
    # згенерований конфіг НІКОЛИ не посилається на відсутній сертифікат.
    return render_template('nginx-bootstrap.conf.tmpl', %v) unless cert_live($d);
    return render_template("nginx-$e->{type}.conf.tmpl", %v);
}

# ─────────────────────── генерація docker-compose ───────────────────────

sub domain_yml_path { my ($d) = @_; "$ROOT/docker-compose.domains/$d.yml" }

# Файл домену включається в стек, тільки якщо він існує і вже заповнений:
# каркас proxy-сайту з CHANGE-ME навмисно лишається поза стеком, щоб
# `docker compose up` не спіткнувся об неіснуючий образ.
sub domain_yml_ready {
    my ($d) = @_;
    my $c = slurp(domain_yml_path($d));
    return 0 unless defined $c;
    return 0 if $c =~ /CHANGE-ME/;
    return 1;
}

sub domain_yml_body {
    my ($e) = @_;
    my $d = $e->{domain};
    return undef if $e->{type} eq 'redirect';   # редіректу контейнер не потрібен
    my %v = (
        domain     => $d,
        sid        => sid_of($d),
        sites_root => $CFG{sites_root},
        wp_image   => $e->{image}    || $CFG{wordpress_image},
        db_image   => $e->{db_image} || $CFG{db_image},
        db_name    => $e->{db_name}  || db_name_of($d),
        db_user    => $e->{db_user}  || db_user_of($d),
        upstream   => $e->{upstream} // '',
        app_service=> $e->{app_service} || upstream_host($e->{upstream} // ''),
    );
    return render_template('domain-wordpress.yml.tmpl', %v) if $e->{type} eq 'wordpress';
    return render_template('domain-proxy.yml.tmpl', %v);
}

sub upstream_host {
    my ($u) = @_;
    $u =~ s/:\d+$//;
    return $u;
}

# Webroot домену так, як його бачать webserver і certbot.
#   WordPress — named volume: той самий каталог ділять php-fpm і nginx,
#               оголошення bind'а живе в одному місці (файлі домену).
#   redirect/proxy — прямий bind: контейнера-власника немає взагалі.
sub webroot_mount {
    my ($e, $ro) = @_;
    my $d = $e->{domain};
    return 'wordpress-' . sid_of($d) . ":/var/www/html/$d" if $e->{type} eq 'wordpress';
    return "$CFG{sites_root}/$d/web:/var/www/html/$d" . ($ro ? ':ro' : '');
}

sub compose_main_body {
    my (@doms) = @_;
    my (@deps, @wsvol, @cbvol);
    for my $e (@doms) {
        my $d = $e->{domain};
        push @deps, '      - wordpress-' . sid_of($d) if $e->{type} eq 'wordpress';
        push @deps, "      - $e->{app_service}"
            if $e->{type} eq 'proxy' && $e->{app_service} && domain_yml_ready($d);
        push @wsvol, "      - ./nginx/nginx-$d.conf:/etc/nginx/conf.d/$d.conf:ro";
        push @wsvol, '      - ' . webroot_mount($e, 1);
        push @cbvol, '      - ' . webroot_mount($e, 0);
    }
    my $deps = @deps ? "    depends_on:\n" . join("\n", @deps) : '';
    # Власний головний конфіг, якщо він є. Директиви головного контексту
    # (quic_bpf, worker_processes) у conf.d не працюють — лише тут.
    unshift @wsvol, '      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro'
        if -f "$ROOT/nginx/nginx.conf";
    my %v = (
        %CFG,
        webserver_depends => $deps,
        webserver_volumes => join("\n", @wsvol),
        certbot_volumes   => join("\n", @cbvol),
    );
    my $body = render_template('compose-main.yml.tmpl', %v);
    # Порожній {{webserver_depends}} (стек без жодного контейнерного домену)
    # лишає по собі зайвий порожній рядок посеред YAML.
    $body =~ s/\n\n+/\n\n/g;
    return $body;
}

sub compose_root_body {
    my (@doms) = @_;
    my @inc = map  { "  - docker-compose.domains/$_->{domain}.yml" }
              grep { domain_yml_ready($_->{domain}) } @doms;
    return render_template('compose-root.yml.tmpl',
        project  => $CFG{project},
        includes => join("\n", @inc),
    );
}

# ─────────────────────────── render ───────────────────────────

sub ensure_site_dirs {
    my ($e) = @_;
    my $d = $e->{domain};
    for my $sub ($e->{type} eq 'wordpress' ? ('web', 'db') : ('web')) {
        my $p = "$CFG{sites_root}/$d/$sub";
        next if -d $p;
        make_path($p) or die_err "не можу створити $p: $!";
        # web-корінь WordPress віддаємо www-data (uid/gid 33 у Debian-образах):
        # php-fpm пише туди оновлення й завантаження. Каталог БД чіпати не
        # треба — mariadb сама перебирає його на себе при першому старті.
        chown(33, 33, $p) if $sub eq 'web' && $e->{type} eq 'wordpress' && $> == 0;
        say_ok "створено $p";
    }
}

sub render_all {
    my (%o) = @_;
    my @all  = reg_enabled();
    my %only = map { $_ => 1 } @{ $o{only} || [] };
    # Файли генеруються для @doms (можливо, одного домену), а зведені
    # docker-compose.yml і .main.yml — завжди для всього реєстру.
    my @doms = %only ? grep { $only{$_->{domain}} } @all : @all;

    for my $e (@doms) {
        my $d = $e->{domain};
        ensure_site_dirs($e) unless $o{no_dirs};
        secret_ensure($e) if $e->{type} eq 'wordpress';

        for my $hook ("$ROOT/nginx/custom/$d.conf",
                      ($e->{type} eq 'wordpress' ? "$ROOT/nginx/custom/$d.php.conf" : ())) {
            next if -f $hook;
            write_file($hook,
                "# Правки для $d, які переживають `dcpmgmt render --force`.\n"
              . "# Цей файл dcpmgmt не перезаписує ніколи. Порожній — це нормально.\n",
                quiet => 1);
        }

        write_file(nginx_conf_path($d), nginx_conf_body($e), %o);
        if ($e->{type} eq 'redirect') {
            my $idx = "$CFG{sites_root}/$d/web/index.html";
            write_file($idx, render_template('redirect-index.html.tmpl', target => $e->{target}), %o)
                unless $o{no_dirs};
        }
        my $yml = domain_yml_body($e);
        if (defined $yml) {
            # Файл proxy-домену описує ЧУЖИЙ застосунок і належить адміну:
            # --force регенерує наші шаблони, а не чужу роботу. Щоб отримати
            # свіжий каркас — видаліть файл і повторіть render.
            my %fo = $e->{type} eq 'proxy' ? (%o, force => 0, owned_by_admin => 1) : %o;
            write_file(domain_yml_path($d), $yml, %fo);
        }
        elsif (-f domain_yml_path($d)) {
            # redirect обслуговує сам nginx: контейнер-пустушка (alpine у
            # вічному sleep) існував лише щоб створити named volume.
            if ($o{force}) {
                rename domain_yml_path($d), domain_yml_path($d) . '.bak';
                say_ok "docker-compose.domains/$d.yml — прибрано (редіректу контейнер не потрібен), копія в .bak";
            } else {
                say_warn "docker-compose.domains/$d.yml зайвий: редірект обслуговує nginx, "
                       . 'контейнер не потрібен (--force прибере, зберігши .bak)';
            }
        }
    }

    # ці два файли повністю належать інструменту — завжди перезаписуються
    my %own = (%o, force => 1);
    write_file("$ROOT/docker-compose.main.yml", compose_main_body(@all), %own);
    write_file("$ROOT/docker-compose.yml",      compose_root_body(@all), %own);

    for my $e (@all) {
        next unless $e->{type} eq 'proxy';
        next if domain_yml_ready($e->{domain});
        say_warn "docker-compose.domains/$e->{domain}.yml ще містить CHANGE-ME — "
               . "домен поза стеком, nginx для нього не підніметься (host not found in upstream)";
    }
}

# ─────────────────────────── сертифікати ───────────────────────────

sub cert_issue {
    my ($d, %o) = @_;
    if (cert_live($d) && !$o{force}) {
        say_ok "сертифікат для $d вже є — видачу пропущено";
        return 1;
    }
    unless (container_running('webserver')) {
        die_err "webserver не працює, а Let's Encrypt має достукатись до\n"
              . "       http://$d/.well-known/acme-challenge/. Спершу: dcpmgmt apply";
    }
    say_step "Первинна видача сертифіката для $d";
    say_info 'вимоги: A/AAAA-запис уже вказує на цей сервер, порт 80 доступний ззовні,';
    say_info 'а якщо домен за Cloudflare — проксі поки вимкнено (сіра хмарка).';

    # Одноразовий контейнер, а не `docker exec` у certbot: той сидить у циклі
    # renew і тримає lock — exec впаде з "Another instance of Certbot is
    # already running". Монтуємо шляхи хоста напряму, щоб не залежати від
    # префікса імені compose-проєкту в назвах volume'ів.
    my @cmd = (
        'docker', 'run', '--rm',
        '-v', "$CFG{letsencrypt_dir}/etc:/etc/letsencrypt",
        '-v', "$CFG{letsencrypt_dir}/var:/var/lib/letsencrypt",
        '-v', "$CFG{sites_root}/$d/web:/var/www/html/$d",
        $CFG{certbot_image}, 'certonly', '--webroot',
        '--webroot-path', "/var/www/html/$d",
        '-d', $d,
        '--email', $CFG{certbot_email},
        '--agree-tos', '--no-eff-email', '--non-interactive',
    );
    push @cmd, '--staging'      if $o{staging};
    push @cmd, '--force-renewal' if $o{force};

    unless (run(@cmd)) {
        die_err "certbot не видав сертифікат для $d.\n"
              . "       Найчастіші причини: DNS ще не вказує сюди; порт 80 закрито;\n"
              . "       Cloudflare-проксі увімкнено; вичерпано ліміт Let's Encrypt\n"
              . "       (5 невдалих валідацій/год, 50 сертифікатів/тиждень на домен).\n"
              . "       Ліміти НЕ обходяться повторами наосліп — розберіться з причиною.\n"
              . "       Для перевірки без витрати лімітів: dcpmgmt cert issue $d --staging";
    }
    say_ok "сертифікат для $d отримано";
    return 1;
}

sub cmd_cert {
    my @args = @_;
    my $sub = shift @args // '';
    my ($staging, $force) = (0, 0);
    GetOptionsFromArray(\@args, 'staging' => \$staging, 'force' => \$force)
        or die_err 'невідомий ключ';
    my $d = shift @args;

    if ($sub eq 'issue') {
        die_err 'потрібен домен: dcpmgmt cert issue <domain>' unless $d;
        die_err "домену $d немає в реєстрі" unless reg_load_one($d);
        cert_issue($d, staging => $staging, force => $force);
        render_all(force => 1, only => [$d]);
        nginx_test_reload();
    }
    elsif ($sub eq 'renew') {
        my @doms = $d ? ($d) : map { $_->{domain} } reg_enabled();
        for my $dom (@doms) {
            my @cmd = (
                'docker', 'run', '--rm',
                '-v', "$CFG{letsencrypt_dir}/etc:/etc/letsencrypt",
                '-v', "$CFG{letsencrypt_dir}/var:/var/lib/letsencrypt",
                '-v', "$CFG{sites_root}/$dom/web:/var/www/html/$dom",
                $CFG{certbot_image}, 'renew', '--cert-name', $dom,
            );
            push @cmd, '--force-renewal' if $force;
            run(@cmd) or say_warn "renew для $dom завершився помилкою";
        }
        nginx_test_reload();
    }
    elsif ($sub eq 'list') {
        for my $e (reg_all()) {
            my $d2 = $e->{domain};
            printf "  %-34s %s\n", $d2, cert_expiry($d2) // c('1;31', 'сертифіката немає');
        }
    }
    else {
        die_err 'dcpmgmt cert issue|renew|list [<domain>] [--staging] [--force]';
    }
}

sub cert_expiry {
    my ($d) = @_;
    my $pem = cert_dir($d) . '/cert.pem';
    return undef unless -e $pem;
    my $out = capture('openssl', 'x509', '-enddate', '-noout', '-in', $pem);
    my ($date) = $out =~ /notAfter=(.+)/;
    return $date ? "діє до $date" : 'сертифікат є';
}

# ─────────────────────────── команди ───────────────────────────

sub cmd_init {
    my @args = @_;
    say_step 'Ініціалізація проєкту';
    unless (-f "$ROOT/dcp.conf") {
        my $ex = slurp("$ROOT/dcp.conf.example") or die_err 'немає dcp.conf.example';
        write_file("$ROOT/dcp.conf", $ex, mode => 0600);
        say_warn 'створено dcp.conf із прикладу — ВИПРАВТЕ certbot_email і project, потім повторіть init';
        exit 0;
    }
    load_config();

    for my $d (reg_dir(), "$ROOT/secrets", "$ROOT/nginx/custom",
               "$ROOT/docker-compose.domains",
               $CFG{sites_root}, $CFG{nginx_conf_dir},
               "$CFG{letsencrypt_dir}/etc", "$CFG{letsencrypt_dir}/var") {
        next if -d $d;
        make_path($d) or die_err "не можу створити $d: $!";
        say_ok "створено $d";
    }
    chmod 0700, "$ROOT/secrets";

    render_all();
    say_ok 'структура готова';
    print <<"TXT";

Далі:
  dcpmgmt add wordpress example.com      — повноцінний сайт
  dcpmgmt add redirect old.example.com --to example.com
  dcpmgmt add proxy api.example.com --upstream my-app:8080
  dcpmgmt apply                          — підняти стек

Успадкована інсталяція (стек уже працює, файли є):
  dcpmgmt import      — зібрати реєстр із наявних конфігів, нічого не ламаючи
TXT
}

sub cmd_add {
    my @args = @_;
    my $type = shift @args // '';
    die_err 'тип має бути wordpress | redirect | proxy'
        unless $type =~ /^(wordpress|redirect|proxy)$/;

    my ($target, $upstream, $image, $http3, $no_cert, $staging) = ('', '', '', 'on', 0, 0);
    GetOptionsFromArray(\@args,
        'to=s'       => \$target,
        'upstream=s' => \$upstream,
        'image=s'    => \$image,
        'http3!'     => sub { $http3 = $_[1] ? 'on' : 'off' },
        'no-cert'    => \$no_cert,
        'staging'    => \$staging,
    ) or die_err 'невідомий ключ';

    my $d = lc(shift(@args) // '');
    die_err 'потрібне ім\'я домену' unless $d;
    die_err "'$d' не схоже на ім'я домену (для кирилиці вживайте punycode: xn--...)"
        unless valid_domain($d);
    die_err "домен $d уже є в реєстрі (domains/$d.conf)" if reg_load_one($d);
    die_err 'redirect потребує --to <домен-призначення>' if $type eq 'redirect' && !$target;
    die_err 'proxy потребує --upstream <host:port>'      if $type eq 'proxy'    && !$upstream;
    die_err "--to <domain>: '$target' не схоже на домен"
        if $target && !valid_domain($target);

    load_config();

    my $e = {
        domain => $d, type => $type, http3 => $http3, enabled => 'yes',
        ($target   ? (target   => $target)   : ()),
        ($upstream ? (upstream => $upstream, app_service => upstream_host($upstream)) : ()),
        ($image    ? (image    => $image)    : ()),
    };
    if ($type eq 'wordpress') {
        $e->{db_name}     = db_name_of($d);
        $e->{db_user}     = db_user_of($d);
        $e->{php_service} = 'wordpress-' . sid_of($d);
        $e->{image}     ||= $CFG{wordpress_image};
    }
    reg_save($e);
    say_ok "domains/$d.conf — створено";

    say_step "Крок 1/4: файли та структура";
    render_all(only => [$d]);

    say_step 'Крок 2/4: піднімаємо стек (nginx поки з :80-заглушкою для нового домену)';
    compose('up', '-d', '--remove-orphans') or die_err 'docker compose up завершився помилкою';
    nginx_test_reload();

    unless ($no_cert) {
        say_step 'Крок 3/4: сертифікат';
        cert_issue($d, staging => $staging);
        say_step 'Крок 4/4: бойовий nginx-конфіг з 443';
        render_all(force => 1, only => [$d]);
        compose('up', '-d', '--remove-orphans');
        nginx_test_reload();
    } else {
        say_warn 'видачу сертифіката пропущено (--no-cert): домен віддає :80-заглушку.';
        say_warn "коли DNS буде готовий — dcpmgmt cert issue $d";
    }

    print "\n";
    if ($type eq 'wordpress') {
        say_ok "готово: https://$d/wp-admin/install.php — лишилось пройти майстер WordPress";
        say_info "БД, користувач і пароль уже створені й прописані у wp-config.php;";
        say_info 'майстер спитає лише назву сайту й адміна.';
    } elsif ($type eq 'redirect') {
        say_ok "готово: https://$d/ -> https://$target/ (301, плюс index.html як підстраховка)";
    } else {
        say_ok "готово: https://$d/ -> http://$upstream/";
        say_info "опишіть сервіс застосунку в docker-compose.domains/$d.yml (заміна CHANGE-ME),";
        say_info 'потім: dcpmgmt apply';
    }
}

sub cmd_remove {
    my @args = @_;
    my $purge = 0;
    GetOptionsFromArray(\@args, 'purge' => \$purge) or die_err 'невідомий ключ';
    my $d = lc(shift(@args) // '');
    die_err 'потрібне ім\'я домену' unless $d;
    load_config();
    my $e = reg_load_one($d) or die_err "домену $d немає в реєстрі";

    my $what = $purge
        ? "домен $d РАЗОМ з файлами $CFG{sites_root}/$d (web + база даних!) і сертифікатом"
        : "домен $d зі стека (файли $CFG{sites_root}/$d і сертифікат ЛИШАЮТЬСЯ)";
    confirm("Видалити $what?") or do { say_info 'скасовано'; return };

    my $sid = sid_of($d);
    my @svc = $e->{type} eq 'wordpress' ? ("wordpress-$sid", "db-$sid")
            : $e->{type} eq 'proxy' && $e->{app_service} ? ($e->{app_service}) : ();
    if (@svc) {
        compose('stop', @svc);
        compose('rm', '-f', '-v', @svc);
    }

    unlink reg_path($d), nginx_conf_path($d), domain_yml_path($d);
    unlink "$ROOT/nginx/custom/$d.conf", "$ROOT/nginx/custom/$d.php.conf";
    say_ok "реєстр і згенеровані конфіги для $d прибрано";

    render_all();
    compose('up', '-d', '--remove-orphans');
    nginx_test_reload();

    if ($purge) {
        run('docker', 'run', '--rm',
            '-v', "$CFG{letsencrypt_dir}/etc:/etc/letsencrypt",
            '-v', "$CFG{letsencrypt_dir}/var:/var/lib/letsencrypt",
            $CFG{certbot_image}, 'delete', '--cert-name', $d, '--non-interactive');
        remove_tree("$CFG{sites_root}/$d");
        unlink secret_path($d);
        say_ok "прибрано $CFG{sites_root}/$d, сертифікат і secrets/$d.env";
    } else {
        say_info "дані лишились: $CFG{sites_root}/$d, secrets/$d.env, сертифікат у letsencrypt";
        say_info "повне прибирання: dcpmgmt remove $d --purge (спершу поверніть домен у реєстр)";
    }
}

sub cmd_list {
    my @args = @_;
    my ($names, $type) = (0, '');
    GetOptionsFromArray(\@args, 'names' => \$names, 'type=s' => \$type)
        or die_err 'невідомий ключ';
    load_config();
    my @doms = reg_all();
    @doms = grep { $_->{type} eq $type } @doms if $type;
    if ($names) {                       # для скриптів: по домену на рядок
        print "$_->{domain}\n" for @doms;
        return;
    }
    unless (@doms) { say_info 'реєстр порожній — почніть з dcpmgmt add ... або dcpmgmt import'; return }
    printf "%-34s %-10s %-28s %-5s %s\n", 'ДОМЕН', 'ТИП', 'ПРИЗНАЧЕННЯ', 'H3', 'СЕРТИФІКАТ';
    for my $e (@doms) {
        my $d = $e->{domain};
        my $dest = $e->{type} eq 'redirect' ? "-> $e->{target}"
                 : $e->{type} eq 'proxy'    ? "-> $e->{upstream}"
                 : ($e->{image} // '');
        printf "%-34s %-10s %-28s %-5s %s\n",
            $d, $e->{type}, $dest, ($e->{http3} eq 'on' ? 'так' : 'ні'),
            (cert_live($d) ? 'є' : c('1;31', 'НЕМАЄ'));
    }
}

sub cmd_render {
    my @args = @_;
    my ($force, $diff) = (0, 0);
    GetOptionsFromArray(\@args, 'force' => \$force, 'diff' => \$diff)
        or die_err 'невідомий ключ';
    load_config();
    render_all(force => $force, diff => $diff, (@args ? (only => \@args) : ()));
    say_info 'застосувати до працюючого стека: dcpmgmt apply' unless $diff;
}

# Хеш кожного сервісу з поточної конфігурації compose. Саме за ним compose
# вирішує, чи перестворювати контейнер — тож порівняння «до/після» точно
# відповідає на питання «що саме смикне apply».
sub service_hashes {
    return {} unless have_docker();
    chdir $ROOT;
    return {} unless -f "$ROOT/docker-compose.yml";
    my $out = capture('docker', 'compose', 'config', '--hash=*');
    my %h;
    for my $l (split /\n/, $out) {
        my ($s, $hash) = $l =~ /^(\S+)\s+(\S+)$/ or next;
        $h{$s} = $hash;
    }
    return \%h;
}

sub report_impact {
    my ($before, $after) = @_;
    return 0 unless %$before || %$after;
    my (@new, @gone, @changed);
    for my $s (sort keys %$after) {
        push @new, $s unless exists $before->{$s};
    }
    for my $s (sort keys %$before) {
        if (!exists $after->{$s})              { push @gone, $s }
        elsif ($before->{$s} ne $after->{$s})  { push @changed, $s }
    }
    say_step 'Що зробить apply з контейнерами';
    say_ok 'нічого не перестворюється' unless @new || @gone || @changed;
    say_info 'створити:      ' . join(', ', @new)     if @new;
    say_info 'перестворити:  ' . join(', ', @changed) if @changed;
    say_info 'прибрати:      ' . join(', ', @gone)    if @gone;
    if (grep { /^db-/ } @changed) {
        say_warn 'серед них є контейнери БД. Дані лежать на хості в '
               . "$CFG{sites_root}/<домен>/db і нікуди не діваються,";
        say_warn 'але сайт на час перестворення (кілька секунд) віддаватиме помилку БД.';
    }
    return scalar(@new) + scalar(@gone) + scalar(@changed);
}

sub cmd_apply {
    my @args = @_;
    my $force = 0;
    GetOptionsFromArray(\@args, 'force' => \$force) or die_err 'невідомий ключ';
    load_config();

    my $before = service_hashes();
    say_step 'Генерація конфігурації з реєстру';
    render_all(force => $force);
    my $after = service_hashes();
    report_impact($before, $after);

    unless (confirm('Застосувати до працюючого стека?')) { say_info 'скасовано'; return }
    compose('up', '-d', '--remove-orphans') or die_err 'docker compose up завершився помилкою';
    nginx_test_reload();
    say_ok 'готово';
}

# ─────────────────────────── import ───────────────────────────
#
# Успадкована інсталяція: стек уже працює, реєстру ще немає. Збираємо
# реєстр із того, що є на диску, і НІЧОГО не змінюємо — ні контейнерів,
# ні конфігів. Перевірити наслідки потім: dcpmgmt render --diff.

sub parse_nginx_conf {
    my ($path, $domain) = @_;
    my $c = nginx_uncommented($path) // return undef;
    my %e = (domain => $domain, enabled => 'yes');
    $e{http3} = $c =~ /^\s*http3\s+on;/m ? 'on' : 'off';
    $e{_reuseport} = $c =~ /reuseport/ ? 1 : 0;

    if (my ($php) = $c =~ /fastcgi_pass\s+([\w.-]+):9000;/) {
        $e{type} = 'wordpress';
        $e{php_service} = $php;
    }
    elsif (my ($up) = $c =~ m{proxy_pass\s+https?://([\w.:-]+)/?;}) {
        $e{type} = 'proxy';
        $e{upstream} = $up;
        $e{app_service} = upstream_host($up);
    }
    else {
        $e{type} = 'redirect';
        my ($t) = grep { $_ ne $domain }
                  ($c =~ m{return\s+30[12]\s+https://([\w.-]+)}g);
        unless ($t) {
            my $idx = "$CFG{sites_root}/$domain/web/index.html";
            my $ic = slurp($idx) // '';
            ($t) = $ic =~ m{url=https://([\w.-]+)};
        }
        $e{target} = $t if $t;
    }
    return \%e;
}

sub parse_domain_yml {
    my ($path) = @_;
    my $c = slurp($path) // return {};
    my %y;
    ($y{image})    = $c =~ /^\s*image:\s*(wordpress:\S+)/m;
    ($y{db_image}) = $c =~ /^\s*image:\s*(mariadb\S*|mysql\S*)/m;
    ($y{db_name})  = $c =~ /MYSQL_DATABASE:\s*(\S+)/;
    ($y{db_user})  = $c =~ /MYSQL_USER:\s*(\S+)/;
    ($y{password}) = $c =~ /MYSQL_PASSWORD:\s*(\S+)/;
    delete $y{$_} for grep { !defined $y{$_} } keys %y;
    return \%y;
}

sub cmd_import {
    my @args = @_;
    my $src = $ROOT;
    GetOptionsFromArray(\@args, 'from=s' => \$src) or die_err 'невідомий ключ';
    load_config();
    $src = abs_path($src) or die_err 'немає такого каталогу';

    my @confs = glob("$src/nginx/nginx-*.conf");
    die_err "у $src/nginx/ не знайдено жодного nginx-*.conf" unless @confs;

    my ($n, @notes, @reuse) = (0);
    for my $path (sort @confs) {
        my ($domain) = basename($path) =~ /^nginx-(.+)\.conf$/;
        next unless $domain && valid_domain($domain);

        my $e = parse_nginx_conf($path, $domain) or next;
        push @reuse, $domain if delete $e->{_reuseport};

        if (reg_load_one($domain)) { say_info "$domain — уже в реєстрі, пропущено"; next }

        my $yml = parse_domain_yml("$src/docker-compose.domains/$domain.yml");
        if ($e->{type} eq 'wordpress') {
            $e->{image}    = $yml->{image}    if $yml->{image};
            $e->{db_image} = $yml->{db_image} if $yml->{db_image} && $yml->{db_image} ne $CFG{db_image};
            $e->{db_name}  = $yml->{db_name}  || db_name_of($domain);
            $e->{db_user}  = $yml->{db_user}  || db_user_of($domain);

            if ($yml->{password}) {
                unless (-f secret_path($domain)) {
                    make_path("$ROOT/secrets") unless -d "$ROOT/secrets";
                    chmod 0700, "$ROOT/secrets";
                    write_file(secret_path($domain), secret_body($domain, $yml->{password}),
                               force => 1, mode => 0600, quiet => 1);
                    say_ok "secrets/$domain.env — пароль перенесено з наявного yml (той самий, БД не чіпаємо)";
                }
            } else {
                push @notes, "$domain: не знайшов MYSQL_PASSWORD у docker-compose.domains/$domain.yml "
                           . '— пароль доведеться вписати в secrets/ вручну';
            }
            for my $k (qw(db_name db_user)) {
                my $derived = $k eq 'db_name' ? db_name_of($domain) : db_user_of($domain);
                push @notes, "$domain: $k='$e->{$k}' не збігається зі схемою іменування ('$derived') "
                           . '— лишено як є, БД перейменовувати не треба'
                    if $e->{$k} ne $derived;
            }
            my $expect = 'wordpress-' . sid_of($domain);
            push @notes, "$domain: nginx шле PHP на '$e->{php_service}', а не на '$expect' "
                       . '— перевірте, чи це не copy-paste на чужий сайт'
                if ($e->{php_service} // '') ne $expect;
        }
        push @notes, "$domain: тип redirect, але не знайшов домену призначення "
                   . '— впишіть target у domains/' . $domain . '.conf'
            if $e->{type} eq 'redirect' && !$e->{target};

        reg_save($e);
        say_ok "domains/$domain.conf — $e->{type}"
             . ($e->{target} ? " -> $e->{target}" : '')
             . ($e->{upstream} ? " -> $e->{upstream}" : '');
        $n++;
    }

    say_step "Імпортовано доменів: $n";
    if (@reuse) {
        say_info "reuseport на 443 стоїть у: @reuse";
        if (@reuse == 1 && lc($CFG{quic_reuseport_domain} // '') ne lc $reuse[0]) {
            say_warn "впишіть у dcp.conf:  quic_reuseport_domain = $reuse[0]";
        } elsif (@reuse > 1) {
            say_warn 'reuseport більш ніж в одному vhost — nginx впаде з "duplicate listen options"';
        }
    }
    say_warn $_ for @notes;
    print <<'TXT';

Нічого не змінено, крім реєстру domains/ і secrets/. Далі, не поспішаючи:
  dcpmgmt doctor          — звірити реєстр із тим, що реально на диску
  dcpmgmt render --diff   — побачити, чим згенероване відрізняється від наявного
  dcpmgmt apply           — застосувати (перед цим покаже, які контейнери смикне)
TXT
}

# ─────────────────────────── doctor ───────────────────────────

sub cmd_doctor {
    load_config();
    my @doms = reg_all();
    my ($errs, $warns) = (0, 0);
    my $bad  = sub { $errs++;  say_err @_ };
    my $soft = sub { $warns++; say_warn @_ };

    say_step 'Конфігурація';
    say_ok "проєкт compose: $CFG{project} (префікс імен volume'ів: ${\ $CFG{project}}_)";
    if (have_docker()) {
        my $out = capture('docker', 'ps', '-a', '--filter', 'name=^webserver$',
                          '--format', '{{.Label "com.docker.compose.project"}}');
        chomp $out;
        $bad->("контейнер webserver належить проєкту '$out', а dcp.conf каже '$CFG{project}'.\n"
             . "       Із таким розходженням compose створить НОВІ порожні volume'и замість наявних.\n"
             . "       Виправте project у dcp.conf на '$out'.")
            if $out && $out ne $CFG{project};
    }

    say_step 'Домени';
    my %php_seen;
    for my $e (@doms) {
        my $d = $e->{domain};
        my @p;
        push @p, 'немає nginx-конфіга'         unless -f nginx_conf_path($d);
        push @p, "немає каталогу $CFG{sites_root}/$d/web" unless -d "$CFG{sites_root}/$d/web";
        push @p, 'немає сертифіката'           unless cert_live($d);
        if ($e->{type} eq 'wordpress') {
            push @p, "немає каталогу БД $CFG{sites_root}/$d/db" unless -d "$CFG{sites_root}/$d/db";
            push @p, 'немає secrets/' . "$d.env" unless -f secret_path($d);
            push @p, 'порожній web/ — WordPress не розгорнувся'
                if -d "$CFG{sites_root}/$d/web" && !-e "$CFG{sites_root}/$d/web/index.php";
            if (my $mode = (stat secret_path($d))[2]) {
                $soft->("secrets/$d.env має права " . sprintf('%04o', $mode & 07777) . ', очікується 0600')
                    if ($mode & 07777) != 0600;
            }
            my $php = $e->{php_service} // '';
            $soft->("$d: PHP іде на '$php', який уже обслуговує $php_seen{$php} — copy-paste на чужий сайт?")
                if $php && $php_seen{$php};
            $php_seen{$php} = $d if $php;
        }
        push @p, 'тип redirect без target'     if $e->{type} eq 'redirect' && !$e->{target};
        $soft->("$d: docker-compose.domains/$d.yml ще з CHANGE-ME — опишіть сервіс "
              . 'застосунку, інакше домен лишається поза стеком')
            if $e->{type} eq 'proxy' && -f domain_yml_path($d) && !domain_yml_ready($d);

        if (@p) { $bad->("$d: $_") for @p }
        else    { printf "  %s %-34s %s\n", c('1;32', '  ok  '), $d, cert_expiry($d) // '' }
    }

    say_step 'Подовження сертифікатів';
    # Спільний certbot виконує `certbot renew` для всіх сертифікатів одразу,
    # а шлях до webroot кожен сертифікат пам'ятає у своєму renewal-конфізі,
    # записаному при первинній видачі. Якщо шлях не збігається з тим, що ми
    # монтуємо, подовження тихо провалиться — і виявиться це за 90 днів.
    for my $e (@doms) {
        my $d  = $e->{domain};
        my $rc = "$CFG{letsencrypt_dir}/etc/renewal/$d.conf";
        unless (-e $rc) {
            $soft->("$d: немає $rc — сертифікат не подовжуватиметься автоматично")
                if cert_live($d);
            next;
        }
        my $c = slurp($rc) // next;
        my ($auth) = $c =~ /^authenticator\s*=\s*(\S+)/m;
        $soft->("$d: authenticator=$auth, а не webroot — подовження піде іншим шляхом, "
              . 'перевірте вручну')
            if $auth && $auth ne 'webroot';
        my @paths = $c =~ /^webroot_path\s*=\s*(.+)$/m ? split(/\s*,\s*/, $1) : ();
        push @paths, ($c =~ /^\Q$d\E\s*=\s*(\S+)/m ? $1 : ());
        my $want = "/var/www/html/$d";
        next unless @paths;
        unless (grep { $_ eq $want } @paths) {
            $bad->("$d: у renewal-конфізі webroot_path='" . join(',', @paths) . "', "
                 . "а спільний certbot монтує webroot як '$want'.\n"
                 . "       Подовження провалиться. Полагодити одноразово:\n"
                 . "       sed -i 's,$paths[0],$want,g' $rc");
        }
    }

    say_step 'nginx';
    my @reuse = grep { (nginx_uncommented($_) // '') =~ /reuseport/ } glob("$ROOT/nginx/nginx-*.conf");
    if (@reuse > 1) {
        $bad->('reuseport на 443 більш ніж в одному vhost — nginx впаде з "duplicate listen options": '
             . join(', ', map { basename($_) } @reuse));
    } elsif (!@reuse && grep { $_->{http3} eq 'on' } @doms) {
        $soft->('жоден vhost не має reuseport на 443 — HTTP/3 працюватиме, але без розподілу '
              . 'QUIC-з\'єднань між воркерами (dcp.conf: quic_reuseport_domain)');
    }

    say_step 'Файли без пари';
    my %known = map { $_->{domain} => 1 } @doms;
    for my $f (glob("$ROOT/nginx/nginx-*.conf")) {
        my ($d) = basename($f) =~ /^nginx-(.+)\.conf$/;
        next unless $d && !$known{$d};
        if (valid_domain($d)) {
            $soft->("nginx/nginx-$d.conf є, а домену $d немає в реєстрі (dcpmgmt import?)");
        } else {
            $soft->("nginx/nginx-$d.conf — не конфіг домену і нікуди не монтується. "
                  . 'Директиви головного контексту (quic_bpf) кладіть у nginx/nginx.conf, '
                  . 'він монтується як /etc/nginx/nginx.conf');
        }
    }
    for my $f (glob("$ROOT/docker-compose.domains/*.yml")) {
        my $d = basename($f, '.yml');
        $soft->("docker-compose.domains/$d.yml є, а домену $d немає в реєстрі") unless $known{$d};
    }

    if (have_docker()) {
        say_step 'docker compose config';
        chdir $ROOT;
        if (run('docker', 'compose', 'config', '-q')) { say_ok 'конфігурація коректна' }
        else { $bad->('docker compose config не проходить — стек у такому стані не підніметься') }
    }

    print "\n";
    if ($errs) { say_warn c('1;31', "помилок: $errs, попереджень: $warns"); exit 1 }
    say_ok "помилок немає" . ($warns ? ", попереджень: $warns" : '');
}

# ─────────────────────────── main ───────────────────────────

sub usage {
    print <<'TXT';
dcpmgmt — керування доменами docker web-стека (nginx + WordPress/redirect/proxy)

  dcpmgmt init                          створити структуру проєкту з нуля
  dcpmgmt import [--from DIR]           зібрати реєстр із наявної інсталяції

  dcpmgmt add wordpress <domain> [--image IMG] [--no-http3] [--no-cert]
  dcpmgmt add redirect  <domain> --to <target> [--no-cert]
  dcpmgmt add proxy     <domain> --upstream <host:port> [--no-cert]
  dcpmgmt remove <domain> [--purge]     --purge = разом із даними й сертифікатом

  dcpmgmt list [--type T] [--names]     що є в реєстрі (--names: для скриптів)
  dcpmgmt doctor                        перевірити узгодженість усього
  dcpmgmt render [--diff] [--force] [<domain>...]   перегенерувати файли
  dcpmgmt apply [--force]               застосувати до працюючого стека
  dcpmgmt cert issue|renew|list [<domain>] [--staging] [--force]

Глобальні ключі:  --yes (не питати підтверджень)

Джерело істини — domains/*.conf і dcp.conf; усе інше генерується.
Подробиці: README.md
TXT
}

sub main {
    my @args = @_;
    @args = grep { $_ ne '--yes' or !($YES = 1) } @args;
    my $cmd = shift(@args) // '';

    if    ($cmd eq 'init')    { cmd_init(@args) }
    elsif ($cmd eq 'import')  { cmd_import(@args) }
    elsif ($cmd eq 'add')     { cmd_add(@args) }
    elsif ($cmd eq 'remove'
        || $cmd eq 'rm')      { cmd_remove(@args) }
    elsif ($cmd eq 'list'
        || $cmd eq 'ls')      { cmd_list(@args) }
    elsif ($cmd eq 'render')  { cmd_render(@args) }
    elsif ($cmd eq 'apply')   { cmd_apply(@args) }
    elsif ($cmd eq 'cert')    { cmd_cert(@args) }
    elsif ($cmd eq 'doctor')  { cmd_doctor(@args) }
    elsif ($cmd eq 'version') { print "dcpmgmt $VERSION\n" }
    elsif ($cmd eq 'help' || $cmd eq '--help' || $cmd eq '-h' || $cmd eq '') { usage() }
    else { usage(); die_err "невідома команда '$cmd'" }
}

main(@ARGV);
